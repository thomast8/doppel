#!/bin/zsh
# Doppel CLI: create and manage independent, rebranded instances of a locally
# installed app (currently: the ChatGPT desktop app).
#
#   doppel create --name "ChatGPT Personal" --bundle-id com.openai.codex.secondary \
#       --scheme codex-secondary --profile-root "$HOME/Library/Application Support/ChatGPT Secondary" \
#       --codex-home "$HOME/.codex-secondary" --tint F28C28 [--install-to "$HOME/Applications"]
#   doppel list
#   doppel launch  <name>
#   doppel rebuild <name>

set -eu
setopt PIPE_FAIL

readonly REPO_ROOT="${0:A:h:h}"
readonly ENGINE_SRC="$REPO_ROOT/engine"
readonly DOPPEL_HOME="${DOPPEL_HOME:-$HOME/Library/Application Support/Doppel}"
readonly INSTANCES_ROOT="$DOPPEL_HOME/instances"
readonly LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
readonly BUILD_CACHE="$DOPPEL_HOME/build"
readonly PRIMARY_APP="${DOPPEL_PRIMARY_APP:-/Applications/ChatGPT.app}"
readonly PRIMARY_SCHEME="${DOPPEL_PRIMARY_SCHEME:-codex}"

die() { print -u2 -r -- "doppel: $1"; exit 1 }

slugify() {
    print -r -- "$1" | /usr/bin/tr '[:upper:]' '[:lower:]' | /usr/bin/sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g'
}

compile_helpers() {
    # Always recompile from the repo sources: an mtime-based cache would let a
    # planted binary in the build dir be embedded and signed into a bundle.
    mkdir -p "$BUILD_CACHE"
    local src bin
    for pair in "launcher:doppel-launcher" "alert:doppel-alert"; do
        src="$ENGINE_SRC/${pair%%:*}/main.m"
        bin="$BUILD_CACHE/${pair##*:}"
        /usr/bin/clang -fobjc-arc -O2 -framework Cocoa -framework Security -o "$bin" "$src" || \
            die "compiling ${pair##*:} failed"
    done
}

extract_primary_icon() {
    # Produces a large PNG of the primary app's current icon at $1.
    local out="$1" work
    work="$(/usr/bin/mktemp -d)"
    /usr/bin/iconutil -c iconset "$PRIMARY_APP/Contents/Resources/electron.icns" -o "$work/icon.iconset" || \
        die "extracting the primary icon failed"
    local largest
    largest="$(ls "$work/icon.iconset" | /usr/bin/sort -t_ -k2 -n | /usr/bin/tail -1)"
    /bin/cp "$work/icon.iconset/$largest" "$out"
    /bin/rm -rf "$work"
}

png_to_icns() {
    local png="$1" icns="$2" work size
    work="$(/usr/bin/mktemp -d)"
    mkdir "$work/icon.iconset"
    for size in 16 32 128 256 512; do
        /usr/bin/sips -z $size $size "$png" --out "$work/icon.iconset/icon_${size}x${size}.png" >/dev/null
        /usr/bin/sips -z $((size * 2)) $((size * 2)) "$png" --out "$work/icon.iconset/icon_${size}x${size}@2x.png" >/dev/null
    done
    /usr/bin/iconutil -c icns "$work/icon.iconset" -o "$icns" || die "building the .icns failed"
    /bin/rm -rf "$work"
}

install_engine_assets() {
    local dir="$1"
    mkdir -p "$dir/bin" "$dir/assets"
    /bin/cp "$ENGINE_SRC/doppel-engine.zsh" "$dir/doppel-engine.zsh"
    /bin/chmod 755 "$dir/doppel-engine.zsh"
    /bin/cp "$BUILD_CACHE/doppel-launcher" "$BUILD_CACHE/doppel-alert" "$dir/bin/"
}

# The name lands in a sourced config file, an Info.plist JSON fragment, and a
# bundle filename; restrict it to characters that are inert in all three.
validate_name() {
    local name="$1"
    (( ${#name} <= 64 )) || die "instance names are limited to 64 characters"
    [[ "$name" == [A-Za-z0-9]* && "$name" != *[^A-Za-z0-9\ ._-]* ]] || \
        die "instance names must start with a letter or digit and use only letters, digits, spaces, dots, hyphens, underscores"
}

# Writes the instance config. Values are %q-escaped so sourcing the file can
# never execute smuggled content, and the whole file is rewritten rather than
# line-patched: a sed replacement would itself reinterpret the escaping.
write_config() {
    local dir="$1" name="$2" bundle_id="$3" scheme="$4" profile_root="$5" codex_home="$6"
    {
        print -r -- "# Doppel instance config. Generated by doppel; do not hand-edit quoting."
        printf 'DOPPEL_DISPLAY_NAME=%q\n' "$name"
        printf 'DOPPEL_BUNDLE_ID=%q\n' "$bundle_id"
        printf 'DOPPEL_URL_SCHEME=%q\n' "$scheme"
        printf 'DOPPEL_PROFILE_ROOT=%q\n' "$profile_root"
        printf 'DOPPEL_CODEX_HOME=%q\n' "$codex_home"
    } > "$dir/instance-config.zsh"
}

generate_icon() {
    local dir="$1" tint="$2" icon_override="$3"
    mkdir -p "$dir/assets"
    if [[ -n "$icon_override" ]]; then
        /bin/cp "$icon_override" "$dir/assets/icon.icns"
        /usr/bin/sips -s format png -Z 1024 "$icon_override" --out "$dir/assets/icon.png" >/dev/null
    else
        local source_png="$dir/assets/source.png" tinted_png="$dir/assets/icon.png"
        extract_primary_icon "$source_png"
        (cd "$REPO_ROOT" && uv run --quiet --with pillow python engine/icon/tint_icon.py "$source_png" "$tinted_png" "$tint") || \
            die "tinting the icon failed"
        png_to_icns "$tinted_png" "$dir/assets/icon.icns"
        /bin/rm -f "$source_png"
    fi
}

assemble_instance() {
    local slug="$1" name="$2" bundle_id="$3" scheme="$4" profile_root="$5" codex_home="$6" tint="$7" icon_override="$8"
    local dir="$INSTANCES_ROOT/$slug"
    install_engine_assets "$dir"

    generate_icon "$dir" "$tint" "$icon_override"

    write_config "$dir" "$name" "$bundle_id" "$scheme" "$profile_root" "$codex_home"
    print -r -- "$dir"
}

# Resolves an instance by its directory slug or by its current display name.
# The slug is fixed when an instance is created and never changes, so after a
# rename the two no longer agree — looking up only by re-slugified name would
# make a renamed instance unreachable.
instance_dir_for() {
    local wanted="$1" slug dir
    slug="$(slugify "$wanted")"
    if [[ -n "$slug" && -d "$INSTANCES_ROOT/$slug" ]]; then
        print -r -- "$INSTANCES_ROOT/$slug"
        return 0
    fi
    for dir in "$INSTANCES_ROOT"/*(N/); do
        if [[ "$(config_value "$dir" DOPPEL_DISPLAY_NAME)" == "$wanted" ]]; then
            print -r -- "$dir"
            return 0
        fi
    done
    die "no instance named '$wanted'"
}

# Reads one variable from an instance config by sourcing it in a subshell —
# the same parser the engine uses, so the two can't disagree. Safe because
# create writes %q-escaped values.
config_value() {
    local dir="$1" var="$2"
    ( source "$dir/instance-config.zsh" 2>/dev/null && print -r -- "${(P)var}" )
}

app_path_for() {
    local dir="$1" name
    name="$(config_value "$dir" DOPPEL_DISPLAY_NAME)"
    local install_root
    install_root="$(cat "$dir/install-root" 2>/dev/null || print -r -- "$HOME/Applications")"
    print -r -- "$install_root/$name.app"
}

cmd_create() {
    local name="" bundle_id="" scheme="" profile_root="" codex_home="" tint="" icon_override="" install_to="$HOME/Applications"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --name) name="$2"; shift 2 ;;
            --bundle-id) bundle_id="$2"; shift 2 ;;
            --scheme) scheme="$2"; shift 2 ;;
            --profile-root) profile_root="$2"; shift 2 ;;
            --codex-home) codex_home="$2"; shift 2 ;;
            --tint) tint="$2"; shift 2 ;;
            --icon) icon_override="$2"; shift 2 ;;
            --install-to) install_to="$2"; shift 2 ;;
            *) die "unknown option: $1" ;;
        esac
    done
    [[ -n "$name" ]] || die "create requires --name"
    [[ -n "$tint" || -n "$icon_override" ]] || die "create requires --tint RRGGBB or --icon path.icns"

    validate_name "$name"

    # Everything but the name and color can be derived; flags override.
    local slug
    slug="$(slugify "$name")"
    [[ -n "$slug" ]] || die "the name produces an empty identifier; include at least one letter or digit"
    [[ ! -d "$INSTANCES_ROOT/$slug" ]] || \
        die "an instance with slug '$slug' already exists ($INSTANCES_ROOT/$slug); pick another name or remove it first"
    [[ -n "$bundle_id" ]] || bundle_id="com.openai.codex.doppel-$slug"
    [[ -n "$scheme" ]] || scheme="codex-$slug"
    [[ -n "$profile_root" ]] || profile_root="$HOME/Library/Application Support/$name"
    [[ -n "$codex_home" ]] || codex_home="$HOME/.codex-$slug"

    # These reach an Info.plist JSON literal and a state-directory path
    # component, so restrict them to inert characters.
    [[ "$bundle_id" == [A-Za-z0-9]*([A-Za-z0-9.-]) && "$bundle_id" != *[^A-Za-z0-9.-]* ]] || \
        die "bundle ids may contain only letters, digits, dots, and hyphens"
    [[ "$scheme" == [A-Za-z]* && "$scheme" != *[^A-Za-z0-9.+-]* ]] || \
        die "URL schemes must start with a letter and contain only letters, digits, '+', '-', '.'"
    [[ "$scheme" != "$PRIMARY_SCHEME" ]] || \
        die "URL scheme '$scheme' belongs to the primary app; pick another so deep links keep working"
    [[ "$profile_root" == /* && "$codex_home" == /* ]] || \
        die "--profile-root and --codex-home must be absolute paths"

    # Identity fields must be unique across instances: a shared bundle id
    # confuses Launch Services, a shared profile silently mixes accounts.
    local existing
    for existing in "$INSTANCES_ROOT"/*(N/); do
        [[ "$(config_value "$existing" DOPPEL_BUNDLE_ID)" != "$bundle_id" ]] || \
            die "bundle id '$bundle_id' is already used by instance '${existing:t}'"
        [[ "$(config_value "$existing" DOPPEL_URL_SCHEME)" != "$scheme" ]] || \
            die "URL scheme '$scheme' is already used by instance '${existing:t}'"
        [[ "$(config_value "$existing" DOPPEL_PROFILE_ROOT)" != "$profile_root" ]] || \
            die "profile root '$profile_root' is already used by instance '${existing:t}'"
    done

    compile_helpers
    local dir
    dir="$(assemble_instance "$slug" "$name" "$bundle_id" "$scheme" "$profile_root" "$codex_home" "$tint" "$icon_override")"
    print -r -- "$install_to" > "$dir/install-root"
    mkdir -p "$install_to"
    /bin/zsh "$dir/doppel-engine.zsh" install "$install_to/$name.app"
    print -r -- "created: $install_to/$name.app (instance assets: $dir)"
}

cmd_list() {
    # --porcelain: stable machine-readable output, one instance per line:
    # slug<TAB>name<TAB>app-path<TAB>installed|missing
    # Instance names cannot contain tabs (create validates them), so tab-
    # separated fields are unambiguous. The menu-bar app consumes this instead
    # of parsing config files itself, so the CLI stays the single source of truth.
    local porcelain=0
    [[ "${1:-}" == "--porcelain" ]] && porcelain=1
    [[ -d "$INSTANCES_ROOT" ]] || { (( porcelain )) || print "no instances"; return 0 }
    local dir name app state
    for dir in "$INSTANCES_ROOT"/*(N/); do
        name="$(config_value "$dir" DOPPEL_DISPLAY_NAME)"
        [[ -n "$name" ]] || continue
        app="$(app_path_for "$dir")"
        [[ -d "$app" ]] && state="installed" || state="missing"
        if (( porcelain )); then
            printf '%s\t%s\t%s\t%s\n' "${dir:t}" "$name" "$app" "$state"
        elif [[ "$state" == "installed" ]]; then
            print -r -- "$name  ->  $app"
        else
            print -r -- "$name  ->  (not installed)"
        fi
    done
}

cmd_launch() {
    local dir app
    dir="$(instance_dir_for "$1")"
    app="$(app_path_for "$dir")"
    [[ -d "$app" ]] || die "instance app not installed at $app; run: doppel rebuild '$1'"
    /usr/bin/open -na "$app"
}

# Removal never deletes: the app bundle goes to the Trash and the instance
# definition is kept under state/Removed, so a removal can be undone. Account
# data (profile + CODEX_HOME) is left untouched unless --purge-data is given,
# and even then it is moved to the Trash rather than erased.
cmd_remove() {
    local target="" purge=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --purge-data) purge=1; shift ;;
            -*) die "unknown option: $1" ;;
            *) target="$1"; shift ;;
        esac
    done
    [[ -n "$target" ]] || die "usage: doppel remove <name> [--purge-data]"

    local dir app bundle_id profile_root codex_home
    dir="$(instance_dir_for "$target")"
    app="$(app_path_for "$dir")"
    bundle_id="$(config_value "$dir" DOPPEL_BUNDLE_ID)"
    profile_root="$(config_value "$dir" DOPPEL_PROFILE_ROOT)"
    codex_home="$(config_value "$dir" DOPPEL_CODEX_HOME)"

    if /usr/bin/pgrep -f "${app}/Contents/MacOS/" >/dev/null 2>&1; then
        /usr/bin/osascript -e "tell application id \"$bundle_id\" to quit" >/dev/null 2>&1 || true
        local waited=0
        while (( waited < 15 )) && /usr/bin/pgrep -f "${app}/Contents/MacOS/" >/dev/null 2>&1; do
            /bin/sleep 1
            (( waited++ ))
        done
        ! /usr/bin/pgrep -f "${app}/Contents/MacOS/" >/dev/null 2>&1 || \
            die "'$target' is still running; quit it and try again"
    fi

    local stamp="$(/bin/date '+%Y%m%d-%H%M%S')"
    local trash="$HOME/.Trash"
    mkdir -p "$trash"

    if [[ -d "$app" ]]; then
        "$LSREGISTER" -u "$app" >/dev/null 2>&1 || true
        /bin/mv "$app" "$trash/${app:t:r}.$stamp.app" || die "moving the app bundle to the Trash failed"
        print -r -- "moved to Trash: ${app:t}"
    fi

    local removed_root="$DOPPEL_HOME/state/Removed"
    mkdir -p "$removed_root"
    /bin/mv "$dir" "$removed_root/${dir:t}.$stamp" || die "preserving the instance definition failed"
    print -r -- "instance definition kept at: $removed_root/${dir:t}.$stamp"

    if (( purge )); then
        local data
        for data in "$profile_root" "$codex_home"; do
            [[ -n "$data" && -d "$data" ]] || continue
            /bin/mv "$data" "$trash/${data:t}.$stamp" || die "moving $data to the Trash failed"
            print -r -- "moved to Trash: ${data:t}"
        done
    else
        print -r -- "account data left in place (pass --purge-data to move it to the Trash):"
        [[ -n "$profile_root" ]] && print -r -- "  $profile_root"
        [[ -n "$codex_home" ]] && print -r -- "  $codex_home"
    fi
}

# Renames an instance and/or changes its icon colour. Identity and data stay
# put: the slug, bundle id, URL scheme and profile paths are all fixed at
# creation, so a rename never orphans an account's chats or login.
cmd_edit() {
    local target="" new_name="" tint="" icon_override=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --rename) new_name="$2"; shift 2 ;;
            --tint) tint="$2"; shift 2 ;;
            --icon) icon_override="$2"; shift 2 ;;
            -*) die "unknown option: $1" ;;
            *) target="$1"; shift ;;
        esac
    done
    [[ -n "$target" ]] || die "usage: doppel edit <name> [--rename <new name>] [--tint RRGGBB] [--icon path.icns]"
    [[ -n "$new_name" || -n "$tint" || -n "$icon_override" ]] || \
        die "nothing to change; pass --rename, --tint or --icon"

    local dir old_app bundle_id
    dir="$(instance_dir_for "$target")"
    old_app="$(app_path_for "$dir")"
    bundle_id="$(config_value "$dir" DOPPEL_BUNDLE_ID)"

    if [[ -n "$new_name" ]]; then
        validate_name "$new_name"
        local existing existing_name
        for existing in "$INSTANCES_ROOT"/*(N/); do
            [[ "$existing" != "$dir" ]] || continue
            existing_name="$(config_value "$existing" DOPPEL_DISPLAY_NAME)"
            [[ "$existing_name" != "$new_name" ]] || \
                die "another instance is already called '$new_name'"
        done
    fi

    # The bundle is replaced in place, so the running copy has to go first.
    if /usr/bin/pgrep -f "${old_app}/Contents/MacOS/" >/dev/null 2>&1; then
        /usr/bin/osascript -e "tell application id \"$bundle_id\" to quit" >/dev/null 2>&1 || true
        local waited=0
        while (( waited < 15 )) && /usr/bin/pgrep -f "${old_app}/Contents/MacOS/" >/dev/null 2>&1; do
            /bin/sleep 1
            (( waited++ ))
        done
        ! /usr/bin/pgrep -f "${old_app}/Contents/MacOS/" >/dev/null 2>&1 || \
            die "'$target' is still running; quit it and try again"
    fi

    if [[ -n "$tint" || -n "$icon_override" ]]; then
        generate_icon "$dir" "$tint" "$icon_override"
    fi

    if [[ -n "$new_name" ]]; then
        write_config "$dir" "$new_name" "$bundle_id" \
            "$(config_value "$dir" DOPPEL_URL_SCHEME)" \
            "$(config_value "$dir" DOPPEL_PROFILE_ROOT)" \
            "$(config_value "$dir" DOPPEL_CODEX_HOME)"
    fi

    local new_app
    new_app="$(app_path_for "$dir")"
    if [[ "$new_app" != "$old_app" && -d "$old_app" ]]; then
        [[ ! -e "$new_app" ]] || die "an app already exists at $new_app"
        "$LSREGISTER" -u "$old_app" >/dev/null 2>&1 || true
        /bin/mv "$old_app" "$new_app" || die "renaming the app bundle failed"
    fi

    compile_helpers
    install_engine_assets "$dir"
    /bin/zsh "$dir/doppel-engine.zsh" install "$new_app"
    "$LSREGISTER" -f "$new_app" >/dev/null 2>&1 || true
    print -r -- "updated: $new_app"
}

cmd_rebuild() {
    local dir app
    dir="$(instance_dir_for "$1")"
    app="$(app_path_for "$dir")"
    compile_helpers
    install_engine_assets "$dir"
    /bin/zsh "$dir/doppel-engine.zsh" install "$app"
    print -r -- "rebuilt: $app"
}

case "${1:-}" in
    create) shift; cmd_create "$@" ;;
    list) shift; cmd_list "$@" ;;
    launch) [[ $# -eq 2 ]] || die "usage: doppel launch <name>"; cmd_launch "$2" ;;
    rebuild) [[ $# -eq 2 ]] || die "usage: doppel rebuild <name>"; cmd_rebuild "$2" ;;
    edit) shift; cmd_edit "$@" ;;
    remove) shift; cmd_remove "$@" ;;
    *) die "usage: doppel {create|list|launch|rebuild|edit|remove} ..." ;;
esac
