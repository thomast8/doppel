#!/bin/zsh
# Doppel CLI: create and manage independent, rebranded instances of a locally
# installed app (currently: the ChatGPT desktop app).
#
#   doppel create --name "ChatGPT Personal" --bundle-id com.openai.codex.secondary \
#       --scheme codex-secondary --profile-root "$HOME/Library/Application Support/ChatGPT Secondary" \
#       --codex-home "$HOME/.codex-secondary" --tint F28C28 [--install-to "$HOME/Applications"]
#   doppel list
#   doppel launch  <name>
#   doppel rebuild <name>

set -eu
setopt PIPE_FAIL

readonly DOPPEL_CLI_PATH="${0:A}"
readonly REPO_ROOT="${DOPPEL_CLI_PATH:h:h}"
readonly ENGINE_SRC="$REPO_ROOT/engine"
readonly LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
# Inside an installed app the helpers ship prebuilt and sealed by the bundle's
# signature; from a repo checkout they are compiled on demand.
readonly PREBUILT_DIR="$REPO_ROOT/prebuilt"

# Installed copies ignore the overrides below unless explicitly put into
# development mode, so a same-user process cannot redirect an unattended update
# check or the identity every vendor check compares against.
#
# This has to run before the values are read, not merely before they are used:
# an earlier version of this block sat after the assignments below, which made
# it a no-op — `readonly PRIMARY_TEAM_ID="${DOPPEL_PRIMARY_TEAM_ID:-...}"` had
# already captured the caller's value. Keep every override-derived assignment
# after this point.
#
# The signing and state variables are scrubbed here even though this script
# never reads them, because the engine does and this script is its parent. The
# engine's own guard only fires for the copy embedded inside an instance
# bundle; the copy that `rebuild` and `update apply` execute lives under
# instances/<slug>/, so scrubbing here is the only thing that stops a caller
# choosing which certificate signs a rebuild and then gets recorded as that
# instance's pin. DOPPEL_PRIMARY_APP is still forwarded explicitly to the
# engine by the rebuild path after validation; that is a deliberate handoff,
# not an inherited override.
if [[ ("${0:A}" == */Doppel.app/Contents/Resources/doppel/* || \
       "${0:A}" == */Contents/Resources/Doppel/bin/doppel) && \
      "${DOPPEL_DEV:-0}" != "1" ]]; then
    unset DOPPEL_HOME DOPPEL_APPCAST_URL DOPPEL_UPDATE_ROOT \
          DOPPEL_PRIMARY_APP DOPPEL_PRIMARY_BUNDLE_ID \
          DOPPEL_PRIMARY_SCHEME DOPPEL_PRIMARY_TEAM_ID \
          DOPPEL_SIGN_IDENTITY DOPPEL_SIGN_IDENTITY_NAME DOPPEL_SIGN_LEAF_SHA1 \
          DOPPEL_ASSET_ROOT DOPPEL_STATE_ROOT DOPPEL_PIN_ROOT \
          DOPPEL_IAB_DRY_RUN DOPPEL_IAB_DRY_RUN_DELAY DOPPEL_REMODEX_BIN
fi

readonly DOPPEL_HOME="${DOPPEL_HOME:-$HOME/Library/Application Support/Doppel}"
readonly INSTANCES_ROOT="$DOPPEL_HOME/instances"
readonly BUILD_CACHE="$DOPPEL_HOME/build"
readonly PRIMARY_APP="${DOPPEL_PRIMARY_APP:-/Applications/ChatGPT.app}"
readonly PRIMARY_SCHEME="${DOPPEL_PRIMARY_SCHEME:-codex}"
readonly PRIMARY_BUNDLE_ID="${DOPPEL_PRIMARY_BUNDLE_ID:-com.openai.codex}"
readonly PRIMARY_TEAM_ID="${DOPPEL_PRIMARY_TEAM_ID:-2DC432GLL2}"
# Codex publishes the same production appcast its Sparkle integration uses.
readonly APPCAST_URL="${DOPPEL_APPCAST_URL:-https://persistent.oaistatic.com/codex-app-prod/appcast.xml}"
readonly UPDATE_ROOT="${DOPPEL_UPDATE_ROOT:-$DOPPEL_HOME/updates}"
readonly IAB_SLOT_FILE="$DOPPEL_HOME/state/iab-engine-slot"
readonly IAB_RUNTIME_FILE="$DOPPEL_HOME/state/iab-engine-runtime"
readonly IAB_OPERATION_LOCK="$DOPPEL_HOME/state/IABCoordinator.lock"
readonly CLONE_LAUNCH_ROOT="$DOPPEL_HOME/state/clone-launch"
readonly IAB_ROUTER_ENGINE_MIN="24"

# Both values are interpolated into a code-signing requirement, so they are
# checked once here rather than at every use. A value carrying a quote can
# close the string and append its own clause: a team id of
# `Z" or ! identifier "zzzzzzzz` makes the whole requirement true for anything.
# Only reachable from a checkout or under DOPPEL_DEV=1, but the cost of
# refusing it is one comparison.
[[ "$PRIMARY_BUNDLE_ID" == [A-Za-z0-9]* && "$PRIMARY_BUNDLE_ID" != *[^A-Za-z0-9.-]* ]] || \
    { print -u2 -r -- "doppel: the primary bundle identifier may contain only letters, digits, dots and hyphens"; exit 1 }
[[ ${#PRIMARY_TEAM_ID} -eq 10 && "$PRIMARY_TEAM_ID" != *[^A-Z0-9]* ]] || \
    { print -u2 -r -- "doppel: the primary team identifier must be 10 upper-case letters or digits"; exit 1 }

die() { print -u2 -r -- "doppel: $1"; exit 1 }

# A rollback must remain byte-for-byte restorable, but leaving its signed
# Contents/Info.plist in the normal bundle location makes macOS and Computer
# Use discover it as another installed copy of the live app. Move only that
# plist out of the bundle layout while it is stored. Moving the same bytes back
# restores the original code seal; no identifier or signature is rewritten.
readonly ROLLBACK_INFO_NAME="Info.plist.doppel-rollback"

mask_rollback_app() {
    local app="$1" info hidden
    info="$app/Contents/Info.plist"
    hidden="$app/Contents/$ROLLBACK_INFO_NAME"
    [[ -d "$app" ]] || return 1
    [[ -f "$hidden" && ! -e "$info" ]] && return 0
    [[ -f "$info" && ! -e "$hidden" ]] || return 1
    "$LSREGISTER" -u "$app" >/dev/null 2>&1 || true
    /bin/mv "$info" "$hidden"
}

discoverable_rollback_count() {
    local count=0 backup
    for backup in "$DOPPEL_HOME/state"/*/Backups/*(N/) "$UPDATE_ROOT/Backups"/*(N/); do
        [[ -f "$backup/Contents/Info.plist" ]] || continue
        count=$(( count + 1 ))
    done
    print -r -- "$count"
}

repair_rollback_discovery() {
    local repaired=0 backup
    for backup in "$DOPPEL_HOME/state"/*/Backups/*(N/); do
        [[ -f "$backup/Contents/Info.plist" ]] || continue
        mask_rollback_app "$backup" || die "could not hide stored rollback from app discovery: $backup"
        repaired=$(( repaired + 1 ))
    done
    local hidden_root="$UPDATE_ROOT/.Backups" target
    for backup in "$UPDATE_ROOT/Backups"/*(N/); do
        [[ -f "$backup/Contents/Info.plist" ]] || continue
        /bin/mkdir -p "$hidden_root"
        target="$hidden_root/${backup:t}"
        [[ ! -e "$target" ]] || die "the hidden primary rollback already exists: $target"
        "$LSREGISTER" -u "$backup" >/dev/null 2>&1 || true
        /bin/mv "$backup" "$target" || \
            die "could not move the protected primary rollback into hidden storage: $backup"
        repaired=$(( repaired + 1 ))
    done
    print -r -- "$repaired"
}

slugify() {
    print -r -- "$1" | /usr/bin/tr '[:upper:]' '[:lower:]' | /usr/bin/sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g'
}

# Where the instance helpers come from: the bundled, signature-sealed copies
# when running inside Doppel.app, otherwise freshly compiled sources.
helper_dir() {
    if [[ -x "$PREBUILT_DIR/doppel-launcher" && \
          -x "$PREBUILT_DIR/doppel-alert" && \
          -x "$PREBUILT_DIR/doppel-url-handler" ]]; then
        print -r -- "$PREBUILT_DIR"
    else
        print -r -- "$BUILD_CACHE"
    fi
}

compile_helpers() {
    # Nothing to build when the app shipped them.
    [[ -x "$PREBUILT_DIR/doppel-launcher" && \
       -x "$PREBUILT_DIR/doppel-alert" && \
       -x "$PREBUILT_DIR/doppel-url-handler" ]] && return 0
    # Always recompile from the repo sources: an mtime-based cache would let a
    # planted binary in the build dir be embedded and signed into a bundle.
    mkdir -p "$BUILD_CACHE"
    local src bin
    for pair in "launcher:doppel-launcher" "alert:doppel-alert" "url-handler:doppel-url-handler"; do
        src="$ENGINE_SRC/${pair%%:*}/main.m"
        bin="$BUILD_CACHE/${pair##*:}"
        /usr/bin/clang -fobjc-arc -O2 -framework Cocoa -framework ApplicationServices \
            -framework AVFoundation -framework UserNotifications -framework Security \
            -framework CoreServices \
            -o "$bin" "$src" || \
            die "compiling ${pair##*:} failed"
    done
    /usr/bin/swiftc -O "$ENGINE_SRC/icon/main.swift" -o "$BUILD_CACHE/doppel-icon" 2>/dev/null || \
        die "compiling doppel-icon failed"
}

extract_primary_icon() {
    # Produces a large PNG of the primary app's current icon at $1.
    local out="$1" work
    work="$(/usr/bin/mktemp -d)"
    /usr/bin/iconutil -c iconset "$PRIMARY_APP/Contents/Resources/electron.icns" -o "$work/icon.iconset" || \
        die "extracting the primary icon failed"
    local largest
    largest="$(ls "$work/icon.iconset" | /usr/bin/sort -t_ -k2 -n | /usr/bin/tail -1)"
    /bin/cp "$work/icon.iconset/$largest" "$out"
    /bin/rm -rf "$work"
}

png_to_icns() {
    local png="$1" icns="$2" work size
    work="$(/usr/bin/mktemp -d)"
    mkdir "$work/icon.iconset"
    for size in 16 32 128 256 512; do
        /usr/bin/sips -z $size $size "$png" --out "$work/icon.iconset/icon_${size}x${size}.png" >/dev/null
        /usr/bin/sips -z $((size * 2)) $((size * 2)) "$png" --out "$work/icon.iconset/icon_${size}x${size}@2x.png" >/dev/null
    done
    /usr/bin/iconutil -c icns "$work/icon.iconset" -o "$icns" || die "building the .icns failed"
    /bin/rm -rf "$work"
}

install_router_assets() {
    local dir="$1"
    mkdir -p "$dir/bin" "$dir/engine"
    # A managed app can be opened directly from Finder or the Dock, bypassing
    # the menu-bar app. Embed the same signed routing CLI and its expected
    # layout so an assigned profile still resolves through the official engine.
    /bin/cp "$ENGINE_SRC/doppel-engine.zsh" "$dir/doppel-engine.zsh"
    /bin/cp "$DOPPEL_CLI_PATH" "$dir/bin/doppel"
    /bin/cp "$ENGINE_SRC/doppel-engine.zsh" "$dir/engine/doppel-engine.zsh"
    /bin/cp "$ENGINE_SRC/patch-deep-link.py" "$dir/engine/patch-deep-link.py"
    /bin/chmod 755 "$dir/doppel-engine.zsh" "$dir/bin/doppel" \
        "$dir/engine/doppel-engine.zsh"
}

install_engine_assets() {
    local dir="$1"
    mkdir -p "$dir/bin" "$dir/assets" "$dir/engine"
    /bin/cp "$ENGINE_SRC/patch-deep-link.py" "$dir/patch-deep-link.py"
    install_router_assets "$dir"
    local helpers; helpers="$(helper_dir)"
    /bin/cp "$helpers/doppel-launcher" "$helpers/doppel-alert" \
        "$helpers/doppel-url-handler" "$dir/bin/"
}

# The name lands in a sourced config file, an Info.plist JSON fragment, and a
# bundle filename; restrict it to characters that are inert in all three.
validate_name() {
    local name="$1"
    (( ${#name} <= 64 )) || die "instance names are limited to 64 characters"
    [[ "$name" == [A-Za-z0-9]* && "$name" != *[^A-Za-z0-9\ ._-]* ]] || \
        die "instance names must start with a letter or digit and use only letters, digits, spaces, dots, hyphens, underscores"
}

# Writes the instance config. Values are %q-escaped so sourcing the file can
# never execute smuggled content, and the whole file is rewritten rather than
# line-patched: a sed replacement would itself reinterpret the escaping.
write_config() {
    local dir="$1" name="$2" bundle_id="$3" scheme="$4" profile_root="$5" codex_home="$6" tint="${7:-}"
    {
        print -r -- "# Doppel instance config. Generated by doppel; do not hand-edit quoting."
        printf 'DOPPEL_DISPLAY_NAME=%q\n' "$name"
        printf 'DOPPEL_BUNDLE_ID=%q\n' "$bundle_id"
        printf 'DOPPEL_URL_SCHEME=%q\n' "$scheme"
        printf 'DOPPEL_PROFILE_ROOT=%q\n' "$profile_root"
        printf 'DOPPEL_CODEX_HOME=%q\n' "$codex_home"
        # Recorded so an editor can show the colour actually in use; a custom
        # .icns leaves it empty.
        printf 'DOPPEL_TINT=%q\n' "$tint"
    } > "$dir/instance-config.zsh"
}

generate_icon() {
    local dir="$1" tint="$2" icon_override="$3"
    mkdir -p "$dir/assets"
    if [[ "$tint" == "original" ]]; then
        # The vendor's own icon, copied untouched: no tint, no recolouring.
        /bin/cp "$PRIMARY_APP/Contents/Resources/electron.icns" "$dir/assets/icon.icns" || \
            die "copying the original icon failed"
        extract_primary_icon "$dir/assets/icon.png"
        return 0
    fi
    compile_helpers
    if [[ -n "$icon_override" ]]; then
        [[ -f "$icon_override" ]] || die "no icon file at $icon_override"
        /bin/cp "$icon_override" "$dir/assets/icon.icns" || die "copying $icon_override failed"
        /usr/bin/sips -s format png -Z 1024 "$icon_override" --out "$dir/assets/icon.png" >/dev/null 2>&1 || \
            die "$icon_override is not an image macOS can read; pass an .icns or .png file"
    else
        local source_png="$dir/assets/source.png" tinted_png="$dir/assets/icon.png"
        extract_primary_icon "$source_png"
        "$(helper_dir)/doppel-icon" "$source_png" "$tinted_png" "$tint" || \
            die "tinting the icon failed"
        png_to_icns "$tinted_png" "$dir/assets/icon.icns"
        /bin/rm -f "$source_png"
    fi
}

assemble_instance() {
    local slug="$1" name="$2" bundle_id="$3" scheme="$4" profile_root="$5" codex_home="$6" tint="$7" icon_override="$8"
    local dir="$INSTANCES_ROOT/$slug"
    install_engine_assets "$dir"

    generate_icon "$dir" "$tint" "$icon_override"

    write_config "$dir" "$name" "$bundle_id" "$scheme" "$profile_root" "$codex_home" "$tint"
    print -r -- "$dir"
}

# Asks a running instance to quit, twice across 40 seconds. Electron apps can
# take a while to wind down, especially one that has just been relaunched, and
# a single impatient attempt turns an ordinary edit or removal into a failure.
quit_instance() {
    local app="$1" bundle_id="$2" label="$3"
    /usr/bin/pgrep -f "${app}/Contents/MacOS/" >/dev/null 2>&1 || return 0

    local quit_error waited attempt
    for attempt in 1 2; do
        quit_error="$(/usr/bin/osascript -e "tell application id \"$bundle_id\" to quit" 2>&1)" || true
        waited=0
        while (( waited < 20 )) && /usr/bin/pgrep -f "${app}/Contents/MacOS/" >/dev/null 2>&1; do
            /bin/sleep 1
            waited=$(( waited + 1 ))
        done
        /usr/bin/pgrep -f "${app}/Contents/MacOS/" >/dev/null 2>&1 || return 0
    done

    # -128 is "user cancelled": the app refused, which normally means a dialog
    # is waiting for an answer.
    if [[ "$quit_error" == *-128* ]]; then
        die "'$label' would not quit — it has a dialog open (a keychain prompt, for example). Answer or dismiss it, then try again."
    fi
    die "'$label' would not quit after 40 seconds. Quit it yourself, then try again."
}

# Replacing electron.icns is not enough on its own: Finder and the Dock keep
# their own caches, so a recoloured instance can keep showing the old icon
# until something invalidates them.
refresh_icon_caches() {
    local app="$1"
    # $USER is absent from the environment launchd gives a GUI app, and under
    # set -u referencing it aborts the whole command — after the work has
    # already succeeded, which reads as a failure that isn't one.
    local user; user="$(/usr/bin/id -un)"
    /usr/bin/touch "$app" 2>/dev/null || true
    "$LSREGISTER" -f "$app" >/dev/null 2>&1 || true
    /usr/bin/killall -u "$user" Dock >/dev/null 2>&1 || true
    /usr/bin/killall -u "$user" Finder >/dev/null 2>&1 || true
    return 0
}

# A directory only counts as an instance once its config is there to read. A
# create that failed part way through leaves the directory without one, and
# treating that as an instance used to abort every later command.
is_instance_dir() {
    [[ -r "$1/instance-config.zsh" ]]
}

# Reads one variable from an instance config by sourcing it in a subshell —
# the same parser the engine uses, so the two can't disagree. Safe because
# create writes %q-escaped values.
#
# This never reports failure. It used to: an unreadable config made the
# subshell exit 127, and `name="$(config_value ...)"` then took that status and
# killed the whole command under set -e, printing nothing at all.
config_value() {
    local dir="$1" var="$2"
    is_instance_dir "$dir" || return 0
    # ${(P)var:-} rather than ${(P)var}: a config written before a field existed
    # must read as empty, not abort the caller under set -u.
    ( source "$dir/instance-config.zsh" 2>/dev/null || true; print -r -- "${(P)var:-}" )
}

# Resolves an instance by its current display name, falling back to its
# directory slug.
#
# Display name first, and that order matters. The slug is fixed at creation, so
# after a rename the two no longer agree; and because several names slugify the
# same way ("QA One" and "QA-One" both give qa-one), matching the slug first
# resolved a renamed instance to a different one and quietly acted on the wrong
# account.
instance_dir_for() {
    local wanted="$1" slug dir
    for dir in "$INSTANCES_ROOT"/*(N/); do
        if [[ "$(config_value "$dir" DOPPEL_DISPLAY_NAME)" == "$wanted" ]]; then
            print -r -- "$dir"
            return 0
        fi
    done
    slug="$(slugify "$wanted")"
    if [[ -n "$slug" ]] && is_instance_dir "$INSTANCES_ROOT/$slug"; then
        print -r -- "$INSTANCES_ROOT/$slug"
        return 0
    fi
    die "no instance named '$wanted'"
}

# The data directories the primary app and the Codex CLI use when nothing
# redirects them. An instance may legitimately be pointed at these to adopt an
# existing account, which makes them exactly the paths --purge-data must never
# move to the Trash.
primary_data_paths() {
    print -r -- "$HOME/Library/Application Support/Codex"
    print -r -- "$HOME/.codex"
    local product
    product="$(/usr/bin/plutil -extract CFBundleName raw "$PRIMARY_APP/Contents/Info.plist" 2>/dev/null)" || product=""
    [[ -n "$product" ]] && print -r -- "$HOME/Library/Application Support/$product"
    return 0
}

# True when a path is something --purge-data must refuse to touch: a home
# directory, one of its standard folders, somewhere outside the home directory
# entirely, or data the primary app is still using.
protected_data_path() {
    local path="${1:A}" home="${HOME:A}" guarded primary
    [[ -n "$path" ]] || return 1
    [[ "$path" != "/" ]] || return 0
    [[ "$path" != "$home" ]] || return 0
    [[ "$path" == "$home"/* ]] || return 0
    for guarded in Library "Library/Application Support" "Library/Preferences" \
                   "Library/Containers" "Library/Caches" Applications Documents \
                   Desktop Downloads Movies Music Pictures Public .config .ssh .gnupg; do
        [[ "$path" != "$home/$guarded" ]] || return 0
    done
    while read -r primary; do
        [[ -n "$primary" ]] || continue
        [[ "$path" != "${primary:A}" ]] || return 0
    done < <(primary_data_paths)
    return 1
}

# True when another instance is pointed at the same data.
data_shared_with_other_instance() {
    local path="$1" self="$2" other
    for other in "$INSTANCES_ROOT"/*(N/); do
        [[ "$other" != "$self" ]] || continue
        [[ "$(config_value "$other" DOPPEL_PROFILE_ROOT)" != "$path" ]] || return 0
        [[ "$(config_value "$other" DOPPEL_CODEX_HOME)" != "$path" ]] || return 0
    done
    return 1
}

app_path_for() {
    local dir="$1" name
    name="$(config_value "$dir" DOPPEL_DISPLAY_NAME)"
    local install_root
    install_root="$(cat "$dir/install-root" 2>/dev/null || print -r -- "$HOME/Applications")"
    print -r -- "$install_root/$name.app"
}

instance_dir_for_app_path() {
    local wanted="$1" dir
    for dir in "$INSTANCES_ROOT"/*(N/); do
        is_instance_dir "$dir" || continue
        [[ "$(app_path_for "$dir")" == "$wanted" ]] && { print -r -- "$dir"; return 0; }
    done
    return 1
}

# MARK: - Movable vendor engine slot
#
# A locally re-signed bundle can never pass ChatGPT's in-app-browser peer
# check. Doppel therefore assigns that capability to a profile, not to its
# clone: the selected profile is launched through the untouched vendor app
# with the same CODEX_HOME and Electron data root. The one-line slot file is
# global because there is exactly one certified vendor runtime in v1.
iab_slot_slug() {
    local slug=""
    [[ -r "$IAB_SLOT_FILE" ]] || return 0
    IFS= read -r slug < "$IAB_SLOT_FILE" || true
    [[ -n "$slug" && "$slug" != *[^a-z0-9-]* ]] || return 0
    is_instance_dir "$INSTANCES_ROOT/$slug" || return 0
    print -r -- "$slug"
}

instance_uses_vendor_engine() {
    local dir="$1" assigned
    assigned="$(iab_slot_slug)"
    [[ -n "$assigned" && "${dir:t}" == "$assigned" ]]
}

# All engine selection, launch and destructive profile operations share this
# lock. Atomic slot writes alone are not enough: without a lease, Release can
# clear the slot after Launch checks it but before the vendor process adopts
# the profile, allowing a later clone launch to open the same Electron root.
typeset -g IAB_OPERATION_LOCK_HELD=0
typeset -g IAB_OPERATION_LOCK_OWNER_PID=""
typeset -g IAB_OPERATION_LOCK_GROUP_PID=""

iab_operation_group_is_alive() {
    local group_id="$1"
    [[ "$group_id" == <1-> ]] || return 1
    /bin/kill -0 -- "-$group_id" 2>/dev/null
}

wait_for_iab_operation_group() {
    local group_id="$1"
    [[ "$group_id" == <1-> ]] || return 0
    while iab_operation_group_is_alive "$group_id"; do
        /bin/sleep 0.05
    done
}

acquire_iab_operation_lock() {
    (( IAB_OPERATION_LOCK_HELD == 0 )) || return 0
    /bin/mkdir -p "${IAB_OPERATION_LOCK:h}"
    local owner modified now stale quarantine attempts=0
    while ! /bin/mkdir "$IAB_OPERATION_LOCK" 2>/dev/null; do
        owner="$(cat "$IAB_OPERATION_LOCK/pid" 2>/dev/null || true)"
        stale=0
        if [[ "$owner" == <1-> ]]; then
            if ! /bin/kill -0 "$owner" 2>/dev/null && \
               ! iab_operation_group_is_alive "$owner"; then
                stale=1
            fi
        elif [[ -z "$owner" ]]; then
            # A creator can be between mkdir and writing its PID. Recover only
            # after that tiny window is certainly over.
            modified="$(/usr/bin/stat -f '%m' "$IAB_OPERATION_LOCK" 2>/dev/null || true)"
            now="$(/bin/date '+%s')"
            [[ "$modified" == <1-> && "$now" == <1-> ]] && \
                (( now - modified >= 5 )) && stale=1
        fi
        (( stale )) || \
            die "another Doppel engine operation is already in progress"

        # Claim the stale directory by atomically moving it out of the lock
        # path. Two reclaimers cannot both remove and replace each other's new
        # lock: only the one whose rename succeeds may retry mkdir.
        quarantine="${IAB_OPERATION_LOCK}.stale.$$.$attempts"
        if /bin/mv "$IAB_OPERATION_LOCK" "$quarantine" 2>/dev/null; then
            /bin/rm -f "$quarantine/pid" 2>/dev/null || true
            /bin/rmdir "$quarantine" 2>/dev/null || true
        fi
        attempts=$(( attempts + 1 ))
        (( attempts < 4 )) || die "the stale Doppel engine-operation lock could not be reclaimed"
    done
    if ! /bin/chmod 700 "$IAB_OPERATION_LOCK" || \
       ! print -r -- "$$" > "$IAB_OPERATION_LOCK/pid"; then
        /bin/rm -f "$IAB_OPERATION_LOCK/pid" 2>/dev/null || true
        /bin/rmdir "$IAB_OPERATION_LOCK" 2>/dev/null || true
        die "could not secure the Doppel engine-operation lock"
    fi
    IAB_OPERATION_LOCK_HELD=1
    IAB_OPERATION_LOCK_OWNER_PID="$$"
    IAB_OPERATION_LOCK_GROUP_PID=""
}

release_iab_operation_lock() {
    (( IAB_OPERATION_LOCK_HELD )) || return 0
    local owner
    owner="$(cat "$IAB_OPERATION_LOCK/pid" 2>/dev/null || true)"
    if [[ -n "$IAB_OPERATION_LOCK_OWNER_PID" && \
          "$owner" == "$IAB_OPERATION_LOCK_OWNER_PID" ]]; then
        # The supervisor is also the session/process-group leader. It may have
        # crashed before its worker, so PID death alone is not permission to
        # release a profile mutation lock.
        [[ "$IAB_OPERATION_LOCK_GROUP_PID" == "$owner" ]] && \
            wait_for_iab_operation_group "$owner"
        /bin/rm -f "$IAB_OPERATION_LOCK/pid" 2>/dev/null || true
        /bin/rmdir "$IAB_OPERATION_LOCK" 2>/dev/null || true
    fi
    IAB_OPERATION_LOCK_HELD=0
    IAB_OPERATION_LOCK_OWNER_PID=""
    IAB_OPERATION_LOCK_GROUP_PID=""
    return 0
}

typeset -g IAB_OPERATION_CHILD_PID=""

interrupt_iab_operation() {
    local exit_code="$1"
    if [[ "$IAB_OPERATION_CHILD_PID" == <1-> ]]; then
        # Engine/profile mutations are critical sections. The worker runs in a
        # separate session, so a signal aimed at this coordinator is deferred
        # until the whole operation finishes. Forwarding it used to let the
        # immediate shell die while `open`, rebuild workers, or filesystem
        # descendants continued after the global lock had been released.
        wait "$IAB_OPERATION_CHILD_PID" 2>/dev/null || true
    fi
    IAB_OPERATION_CHILD_PID=""
    release_iab_operation_lock
    trap - EXIT INT TERM HUP
    exit "$exit_code"
}

# Run the command below a tiny Python supervisor in its own session. Existing
# EXIT traps and `die` calls cannot bypass the parent-held lock, terminal
# signals cannot interrupt the worker tree halfway through profile adoption,
# and the lock is handed to the supervisor PID so an uncatchable coordinator
# death still leaves a live owner until the critical operation has finished.
with_iab_operation_lock() {
    acquire_iab_operation_lock
    local outcome operation="$1"
    shift
    trap 'release_iab_operation_lock' EXIT
    # Avoid a signal landing in the fork-before-trap window. The handlers are
    # installed immediately after the supervisor PID is known.
    trap '' INT TERM HUP
    set +e
    /usr/bin/python3 - "$DOPPEL_CLI_PATH" "$IAB_OPERATION_LOCK" "$operation" "$@" <<'PYIAB' &
import os
import signal
import subprocess
import sys
import time

script, lock_path, operation, *arguments = sys.argv[1:]
os.setsid()
for handled in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
    signal.signal(handled, signal.SIG_IGN)

# The parent changes the PID file from itself to this supervisor immediately
# after fork. Do not begin the operation until that ownership hand-off is
# visible, otherwise a killed coordinator could leave a worker behind a lock
# that another command believes is stale.
deadline = time.monotonic() + 5
while time.monotonic() < deadline:
    try:
        with open(os.path.join(lock_path, "pid"), encoding="ascii") as handle:
            if handle.read().strip() == str(os.getpid()):
                break
    except OSError:
        pass
    time.sleep(0.01)
else:
    raise SystemExit("doppel: engine-operation lock hand-off failed")

worker = subprocess.Popen(
    ["/bin/zsh", script, "__iab-worker", str(os.getpid()), operation, *arguments]
)
raise SystemExit(worker.wait())
PYIAB
    IAB_OPERATION_CHILD_PID=$!
    if ! print -r -- "$IAB_OPERATION_CHILD_PID" > "$IAB_OPERATION_LOCK/pid"; then
        wait "$IAB_OPERATION_CHILD_PID" 2>/dev/null || true
        IAB_OPERATION_CHILD_PID=""
        release_iab_operation_lock
        trap - EXIT INT TERM HUP
        die "could not hand the engine-operation lock to its worker"
    fi
    IAB_OPERATION_LOCK_OWNER_PID="$IAB_OPERATION_CHILD_PID"
    IAB_OPERATION_LOCK_GROUP_PID="$IAB_OPERATION_CHILD_PID"
    trap 'interrupt_iab_operation 130' INT
    trap 'interrupt_iab_operation 143' TERM
    trap 'interrupt_iab_operation 129' HUP
    wait "$IAB_OPERATION_CHILD_PID"
    outcome=$?
    IAB_OPERATION_CHILD_PID=""
    set -e
    release_iab_operation_lock
    trap - EXIT INT TERM HUP
    return "$outcome"
}

chatgpt_process_candidates() {
    if [[ "${DOPPEL_DEV:-0}" == "1" && "${DOPPEL_IAB_DRY_RUN:-0}" == "1" ]]; then
        return 0
    fi
    # pgrep deliberately excludes its ancestor processes on macOS. That makes
    # a Doppel command launched from a Codex task inside official ChatGPT blind
    # to the very vendor engine it must reconcile, so it can report a stale
    # stored owner instead. `comm` is the executable path without arguments;
    # the anchored suffix keeps this to main ChatGPT/ChatGPT.real processes and
    # excludes Electron helpers and this scanner itself.
    /bin/ps -ww -axo pid=,comm= 2>/dev/null | \
        /usr/bin/awk '/\/Contents\/MacOS\/ChatGPT(\.real)?$/ { print $1 }' || true
}

profile_root_is_primary_default() {
    local root="${1:A}" product candidate
    for candidate in "$HOME/Library/Application Support/Codex"; do
        [[ "$root" == "${candidate:A}" ]] && return 0
    done
    product="$(/usr/bin/plutil -extract CFBundleName raw \
        "$PRIMARY_APP/Contents/Info.plist" 2>/dev/null || true)"
    if [[ -n "$product" ]]; then
        candidate="$HOME/Library/Application Support/$product"
        [[ "$root" == "${candidate:A}" ]] && return 0
    fi
    return 1
}

vendor_command_uses_profile() {
    local command="$1" profile_root="$2"
    [[ "$command" == *"--user-data-dir=$profile_root" ]] && return 0
    # A normal Finder/Dock launch has no explicit argument. Treat it as using
    # the vendor's default Electron root when a Doppel profile deliberately
    # adopts that root, otherwise clone and official processes can collide.
    [[ "$command" == "$PRIMARY_APP/Contents/MacOS/"* && \
       "$command" != *"--user-data-dir="* ]] || return 1
    profile_root_is_primary_default "$profile_root"
}

clone_instance_is_running() {
    local app candidates pid command
    app="$(app_path_for "$1")"
    candidates="$(chatgpt_process_candidates)"
    for pid in ${(f)candidates}; do
        [[ "$pid" == <1-> ]] || continue
        command="$(/bin/ps -p "$pid" -o command= 2>/dev/null || true)"
        [[ "$command" == "$app/Contents/MacOS/"* ]] && return 0
    done
    return 1
}

any_chatgpt_process_uses_profile() {
    local dir="$1" profile_root candidates pid command
    profile_root="$(config_value "$dir" DOPPEL_PROFILE_ROOT)"
    [[ -n "$profile_root" ]] || return 1
    candidates="$(chatgpt_process_candidates)"
    for pid in ${(f)candidates}; do
        [[ "$pid" == <1-> ]] || continue
        command="$(/bin/ps -p "$pid" -o command= 2>/dev/null || true)"
        if [[ "$command" == *"--user-data-dir=$profile_root" ]] || \
           vendor_command_uses_profile "$command" "$profile_root"; then
            return 0
        fi
    done
    return 1
}

# Reports only the vendor app's main processes. Helpers live under Frameworks
# and Resources, so path-prefix comparison avoids treating them as a second
# engine and avoids relying on a regex made from a filesystem path.
vendor_main_pids() {
    local candidates pid command
    candidates="$(chatgpt_process_candidates)"
    for pid in ${(f)candidates}; do
        [[ "$pid" == <1-> ]] || continue
        command="$(/bin/ps -p "$pid" -o command= 2>/dev/null || true)"
        [[ "$command" == "$PRIMARY_APP/Contents/MacOS/"* ]] && print -r -- "$pid"
    done
    return 0
}

raw_vendor_profile_pids() {
    local dir="$1" profile_root pids pid command
    profile_root="$(config_value "$dir" DOPPEL_PROFILE_ROOT)"
    [[ -n "$profile_root" ]] || return 0
    pids="$(vendor_main_pids)"
    for pid in ${(f)pids}; do
        command="$(/bin/ps -p "$pid" -o command= 2>/dev/null || true)"
        vendor_command_uses_profile "$command" "$profile_root" && print -r -- "$pid"
    done
    return 0
}

# Describes the official ChatGPT process that is actually using a managed
# profile, independently of the stored Browser assignment. A normal Dock launch
# has no --user-data-dir argument, but can still be a managed profile when that
# profile deliberately owns ChatGPT's default Electron root (Veridue does).
#
# Output is one tab-separated row:
#   none
#   managed<TAB>slug<TAB>name<TAB>pid
#   unmanaged<TAB><TAB>ChatGPT<TAB>pid(s)
#   ambiguous<TAB><TAB>Multiple managed profiles<TAB>pid(s)
vendor_runtime_snapshot() {
    local dir pids pid name runtime_pids="" runtime_names="" runtime_slug="" matches=0
    local vendor_pids
    for dir in "$INSTANCES_ROOT"/*(N/); do
        is_instance_dir "$dir" || continue
        pids="$(raw_vendor_profile_pids "$dir")"
        [[ -n "$pids" ]] || continue
        matches=$(( matches + 1 ))
        name="$(config_value "$dir" DOPPEL_DISPLAY_NAME)"
        runtime_names="${runtime_names:+$runtime_names, }$name"
        runtime_slug="${dir:t}"
        for pid in ${(f)pids}; do
            [[ "$pid" == <1-> ]] || continue
            [[ " $runtime_pids " == *" $pid "* ]] || runtime_pids="${runtime_pids:+$runtime_pids }$pid"
        done
    done
    vendor_pids="$(vendor_main_pids)"
    if (( matches == 0 )); then
        if [[ -n "$vendor_pids" ]]; then
            printf 'unmanaged\t\tChatGPT\t%s\n' "${(j: :)${(f)vendor_pids}}"
        else
            print -r -- "none"
        fi
    elif (( matches == 1 )) && [[ "$runtime_pids" != *" "* ]]; then
        printf 'managed\t%s\t%s\t%s\n' "$runtime_slug" "$runtime_names" "$runtime_pids"
    else
        printf 'ambiguous\t\t%s\t%s\n' \
            "${runtime_names:-Multiple managed profiles}" "$runtime_pids"
    fi
}

process_start_fingerprint() {
    local pid="$1" started
    # `ps` pads lstart to the current output width. The same process therefore
    # produced different hashes in a PTY and a later menu-bar invocation even
    # though its PID and start time were unchanged. Force a stable locale and
    # collapse presentation whitespace before hashing the process identity.
    started="$(LC_ALL=C /bin/ps -p "$pid" -o lstart= 2>/dev/null | \
        /usr/bin/awk '{$1=$1; print}' || true)"
    [[ -n "$started" ]] || return 1
    print -rn -- "$started" | /usr/bin/shasum -a 256 | /usr/bin/awk '{print $1}'
}

write_iab_runtime_receipt() {
    local slug="$1" pid="$2" build="$3" started staged
    started="$(process_start_fingerprint "$pid")" || \
        die "the official ChatGPT engine launched but its process start could not be verified"
    staged="$(/usr/bin/mktemp "${IAB_RUNTIME_FILE}.XXXXXXXX")" || \
        die "could not stage the built-in-browser runtime receipt"
    if ! printf '%s\t%s\t%s\t%s\n' "$slug" "$pid" "$started" "$build" > "$staged" || \
       ! /bin/chmod 600 "$staged" || \
       ! /bin/mv "$staged" "$IAB_RUNTIME_FILE"; then
        /bin/rm -f "$staged"
        die "could not save the built-in-browser runtime receipt"
    fi
}

clear_iab_runtime_receipt() {
    /bin/rm -f "$IAB_RUNTIME_FILE" || \
        die "could not clear the built-in-browser runtime receipt"
}

iab_runtime_pid_for() {
    local dir="$1" slug pid started build extra actual_start current_build raw_pids raw_pid
    [[ -r "$IAB_RUNTIME_FILE" ]] || return 1
    IFS=$'\t' read -r slug pid started build extra < "$IAB_RUNTIME_FILE" || return 1
    [[ -z "$extra" && "$slug" == "${dir:t}" && "$pid" == <1-> && \
       ${#started} -eq 64 && "$started" != *[^a-f0-9]* && "$build" == <1-> ]] || return 1
    current_build="$(primary_version)"
    [[ "$build" == "$current_build" ]] || return 1
    actual_start="$(process_start_fingerprint "$pid" 2>/dev/null || true)"
    [[ "$actual_start" == "$started" ]] || return 1
    raw_pids="$(raw_vendor_profile_pids "$dir")"
    for raw_pid in ${(f)raw_pids}; do
        [[ "$raw_pid" == "$pid" ]] && { print -r -- "$pid"; return 0; }
    done
    return 1
}

vendor_instance_is_running() {
    iab_runtime_pid_for "$1" >/dev/null 2>&1
}

other_vendor_engine_is_running() {
    local dir="$1" profile_root pids pid command
    profile_root="$(config_value "$dir" DOPPEL_PROFILE_ROOT)"
    pids="$(vendor_main_pids)"
    for pid in ${(f)pids}; do
        command="$(/bin/ps -p "$pid" -o command= 2>/dev/null || true)"
        vendor_command_uses_profile "$command" "$profile_root" || return 0
    done
    return 1
}

write_iab_slot() {
    local slug="$1" staged
    /bin/mkdir -p "${IAB_SLOT_FILE:h}"
    staged="$(/usr/bin/mktemp "${IAB_SLOT_FILE}.XXXXXXXX")" || \
        die "could not stage the built-in-browser assignment"
    if ! print -r -- "$slug" > "$staged" || \
       ! /bin/chmod 600 "$staged" || \
       ! /bin/mv "$staged" "$IAB_SLOT_FILE"; then
        /bin/rm -f "$staged"
        die "could not save the built-in-browser assignment"
    fi
    clear_iab_runtime_receipt
}

clear_iab_slot() {
    clear_iab_runtime_receipt
    /bin/rm -f "$IAB_SLOT_FILE" || die "could not clear the built-in-browser assignment"
}

wait_for_vendor_profile_pid() {
    local dir="$1" waited=0 pids
    local -a matching_pids
    while (( waited < 30 )); do
        pids="$(raw_vendor_profile_pids "$dir")"
        if [[ -n "$pids" ]]; then
            matching_pids=("${(f)pids}")
            print -r -- "${matching_pids[1]}"
            return 0
        fi
        /bin/sleep 1
        waited=$(( waited + 1 ))
    done
    return 1
}

require_vendor_compatible_profile() {
    local dir="$1" app name source_build official_build profile_root codex_home
    app="$(app_path_for "$dir")"
    name="$(config_value "$dir" DOPPEL_DISPLAY_NAME)"
    profile_root="$(config_value "$dir" DOPPEL_PROFILE_ROOT)"
    codex_home="$(config_value "$dir" DOPPEL_CODEX_HOME)"
    [[ "$profile_root" == /* && "$codex_home" == /* ]] || \
        die "'$name' does not have absolute profile paths and cannot use the official engine"
    [[ -d "$app" ]] || \
        die "'$name' has no installed Doppel engine to establish profile compatibility; rebuild it before assigning the built-in browser"
    source_build="$(/usr/bin/plutil -extract DoppelSourceBundleVersion raw \
        "$app/Contents/Info.plist" 2>/dev/null || true)"
    official_build="$(primary_version)"
    [[ "$source_build" == "$official_build" && "$official_build" == <1-> ]] || \
        die "'$name' was built from ChatGPT ${source_build:-unknown}, but the official engine is $official_build. Rebuild the profile first so Electron never opens it with a mismatched version."
}

require_compatible_transparent_router_profile() {
    local dir="$1" app name engine_version recorded_router_hash actual_router_hash
    require_vendor_compatible_profile "$dir"
    app="$(app_path_for "$dir")"
    name="$(config_value "$dir" DOPPEL_DISPLAY_NAME)"
    engine_version="$(/usr/bin/plutil -extract DoppelEngineVersion raw \
        "$app/Contents/Info.plist" 2>/dev/null || true)"
    recorded_router_hash="$(/usr/bin/plutil -extract DoppelRouterSHA256 raw \
        "$app/Contents/Info.plist" 2>/dev/null || true)"
    actual_router_hash="$(/usr/bin/shasum -a 256 \
        "$app/Contents/Resources/Doppel/bin/doppel" 2>/dev/null | /usr/bin/awk '{print $1}')"
    [[ "$engine_version" == <1-> ]] && (( engine_version >= IAB_ROUTER_ENGINE_MIN )) && \
        [[ -x "$app/Contents/MacOS/ChatGPT" && \
           -x "$app/Contents/Resources/Doppel/bin/doppel" && \
           -x "$app/Contents/Resources/Doppel/engine/doppel-engine.zsh" && \
           -f "$app/Contents/Resources/Doppel/engine/patch-deep-link.py" && \
           -n "$recorded_router_hash" && "$actual_router_hash" == "$recorded_router_hash" ]] && \
        "$app/Contents/MacOS/ChatGPT" --doppel-verify >/dev/null 2>&1 || \
        die "'$name' is not ready for transparent Built-in Browser routing. Rebuild the profile before assigning or launching the official engine."
}

require_transparent_router_profile() {
    local dir="$1" app name expected_router_hash recorded_router_hash
    require_compatible_transparent_router_profile "$dir"
    app="$(app_path_for "$dir")"
    name="$(config_value "$dir" DOPPEL_DISPLAY_NAME)"
    expected_router_hash="$(/usr/bin/shasum -a 256 "$DOPPEL_CLI_PATH" 2>/dev/null | \
        /usr/bin/awk '{print $1}')"
    recorded_router_hash="$(/usr/bin/plutil -extract DoppelRouterSHA256 raw \
        "$app/Contents/Info.plist" 2>/dev/null || true)"
    [[ -n "$expected_router_hash" && "$recorded_router_hash" == "$expected_router_hash" ]] || \
        die "'$name' is not ready for transparent Built-in Browser routing. Rebuild the profile before assigning or launching the official engine."
}

launch_vendor_instance() {
    local dir="$1"
    shift
    local name app profile_root codex_home vendor_pid official_build scheme arg user_name temp_root
    local -a forwarded_args clean_environment
    name="$(config_value "$dir" DOPPEL_DISPLAY_NAME)"
    app="$(app_path_for "$dir")"
    profile_root="$(config_value "$dir" DOPPEL_PROFILE_ROOT)"
    codex_home="$(config_value "$dir" DOPPEL_CODEX_HOME)"
    scheme="$(config_value "$dir" DOPPEL_URL_SCHEME)"
    for arg in "$@"; do
        # The clone owns its custom callback scheme, while the untouched app
        # owns codex://. Preserve a routed OAuth/deep link by translating only
        # that scheme prefix; every other launch argument is forwarded intact.
        if [[ -n "$scheme" && "$arg" == "$scheme://"* ]]; then
            forwarded_args+=("$PRIMARY_SCHEME://${arg#*://}")
        else
            forwarded_args+=("$arg")
        fi
    done

    validate_vendor_app "$PRIMARY_APP" || \
        die "the official ChatGPT engine is missing or is not valid OpenAI-signed code"
    require_transparent_router_profile "$dir"
    # Never terminate an app merely because the user selected Launch. A profile
    # lock shared by the clone and vendor runtimes risks Chromium corruption;
    # the refusal tells the user exactly which app must be closed first.
    clone_instance_is_running "$dir" && \
        die "'$name' is already running through its Doppel engine. Quit that window, then launch it again to use the built-in browser."

    if any_chatgpt_process_uses_profile "$dir" && ! vendor_instance_is_running "$dir"; then
        die "'$name''s Electron profile is already open through another ChatGPT app. Quit that window before using the built-in browser."
    fi

    if vendor_instance_is_running "$dir"; then
        /usr/bin/open "$PRIMARY_APP" >/dev/null 2>&1 || true
        for arg in $forwarded_args; do
            [[ "$arg" == -psn_* ]] && continue
            [[ "$arg" != -* ]] || \
                die "'$name' is already running, so the launch option '$arg' cannot be delivered. Quit it and try again."
            /usr/bin/open -a "$PRIMARY_APP" "$arg" >/dev/null 2>&1 || \
                die "'$name' is running, but macOS could not deliver '$arg' to the official engine."
        done
        print -r -- "already running with built-in browser: $name"
        return 0
    fi
    other_vendor_engine_is_running "$dir" && \
        die "the official ChatGPT engine is already running for another profile. Quit that ChatGPT window before launching '$name'."

    # CODEX_HOME must exist before Codex starts. A private umask applies only
    # to newly created profile roots; existing account data is left untouched.
    local old_umask
    old_umask="$(umask)"
    umask 077
    /bin/mkdir -p "$profile_root" "$codex_home" || \
        { umask "$old_umask"; die "could not create the data directories for '$name'"; }
    umask "$old_umask"

    # The real process remains /Applications/ChatGPT.app. These supported
    # profile inputs are external launch configuration, not bundle mutation.
    if [[ "${DOPPEL_DEV:-0}" == "1" && "${DOPPEL_IAB_DRY_RUN:-0}" == "1" ]]; then
        local dry_run_delay="${DOPPEL_IAB_DRY_RUN_DELAY:-0}"
        [[ "$dry_run_delay" == (0|1|2|3|4|5) ]] || \
            die "the development IAB dry-run delay must be between 0 and 5 seconds"
        (( dry_run_delay > 0 )) && /bin/sleep "$dry_run_delay"
        printf 'vendor-launch\t%s\t%s\t%s\t%s\n' \
            "$PRIMARY_APP" "$profile_root" "$codex_home" "sparkle-disabled"
        return 0
    fi
    # `open --env` adds to the caller environment; it does not replace it. A
    # launch from Codex can otherwise leak CODEX_SANDBOX_NETWORK_DISABLED,
    # CODEX_CI, thread identity and clone-only DOPPEL_* variables into the
    # official process, disabling Browser even though the signature is valid.
    # Start `open` from an allowlisted baseline, then add only the three inputs
    # the official profile engine intentionally needs.
    user_name="$(/usr/bin/id -un)"
    temp_root="$(/usr/bin/getconf DARWIN_USER_TEMP_DIR 2>/dev/null || print -r -- /tmp)"
    clean_environment=(
        "HOME=$HOME" "USER=$user_name" "LOGNAME=$user_name"
        "PATH=/usr/bin:/bin:/usr/sbin:/sbin" "SHELL=/bin/zsh" "TMPDIR=$temp_root"
    )
    # launchd supplies the user's SSH agent socket. It is not Doppel/Codex
    # execution state, and dropping it would break private Git remotes inside
    # the otherwise official profile.
    [[ -n "${SSH_AUTH_SOCK:-}" ]] && clean_environment+=("SSH_AUTH_SOCK=$SSH_AUTH_SOCK")
    /usr/bin/env -i "$clean_environment[@]" \
        /usr/bin/open -n \
            --env "CODEX_HOME=$codex_home" \
            --env "CODEX_ELECTRON_USER_DATA_PATH=$profile_root" \
            --env "CODEX_SPARKLE_ENABLED=false" \
            -a "$PRIMARY_APP" --args "--user-data-dir=$profile_root" "$forwarded_args[@]" >/dev/null || \
        die "the official ChatGPT engine could not be launched for '$name'"
    vendor_pid="$(wait_for_vendor_profile_pid "$dir")" || \
        die "the official ChatGPT engine opened but did not adopt '$name''s profile"
    official_build="$(primary_version)"
    write_iab_runtime_receipt "${dir:t}" "$vendor_pid" "$official_build"
    print -r -- "launched with built-in browser: $name"
}

cmd_create() {
    local name="" bundle_id="" scheme="" profile_root="" codex_home="" tint="" icon_override="" install_to="$HOME/Applications"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --name) name="$2"; shift 2 ;;
            --bundle-id) bundle_id="$2"; shift 2 ;;
            --scheme) scheme="$2"; shift 2 ;;
            --profile-root) profile_root="$2"; shift 2 ;;
            --codex-home) codex_home="$2"; shift 2 ;;
            --tint) tint="$2"; shift 2 ;;
            --original-icon) tint="original"; shift ;;
            --icon) icon_override="$2"; shift 2 ;;
            --install-to) install_to="$2"; shift 2 ;;
            *) die "unknown option: $1" ;;
        esac
    done
    [[ -n "$name" ]] || die "create requires --name"
    [[ -n "$tint" || -n "$icon_override" ]] || \
        die "create requires --tint RRGGBB, --original-icon, or --icon path.icns"

    validate_name "$name"

    # Everything but the name and color can be derived; flags override.
    local slug
    slug="$(slugify "$name")"
    [[ -n "$slug" ]] || die "the name produces an empty identifier; include at least one letter or digit"
    if [[ -d "$INSTANCES_ROOT/$slug" ]]; then
        is_instance_dir "$INSTANCES_ROOT/$slug" && \
            die "an instance with slug '$slug' already exists ($INSTANCES_ROOT/$slug); pick another name or remove it first"
        die "an earlier create left an incomplete directory at $INSTANCES_ROOT/$slug; delete it and try again"
    fi
    # Installing over whatever happens to sit at the target path would move a
    # stranger's app into Doppel's own backup directory, where nobody would
    # think to look for it.
    [[ ! -e "$install_to/$name.app" ]] || \
        die "an app already exists at $install_to/$name.app; pick another name or move that app aside first"
    [[ -n "$bundle_id" ]] || bundle_id="com.openai.codex.doppel-$slug"
    [[ -n "$scheme" ]] || scheme="codex-$slug"
    [[ -n "$profile_root" ]] || profile_root="$HOME/Library/Application Support/$name"
    [[ -n "$codex_home" ]] || codex_home="$HOME/.codex-$slug"

    # These reach an Info.plist JSON literal and a state-directory path
    # component, so restrict them to inert characters.
    [[ "$bundle_id" == [A-Za-z0-9]*([A-Za-z0-9.-]) && "$bundle_id" != *[^A-Za-z0-9.-]* ]] || \
        die "bundle ids may contain only letters, digits, dots, and hyphens"
    [[ "$scheme" == [A-Za-z]* && "$scheme" != *[^A-Za-z0-9.+-]* ]] || \
        die "URL schemes must start with a letter and contain only letters, digits, '+', '-', '.'"
    # URI schemes are case-insensitive. Comparing their spelling directly
    # would let `Codex` bypass the primary-scheme guard and make an ordinary
    # clone launch compete for the shared OAuth callback.
    [[ "${scheme:l}" != "${PRIMARY_SCHEME:l}" ]] || \
        die "URL scheme '$scheme' belongs to the primary app; pick another so deep links keep working"
    [[ "$profile_root" == /* && "$codex_home" == /* ]] || \
        die "--profile-root and --codex-home must be absolute paths"

    # Identity fields must be unique across instances: a shared bundle id
    # confuses Launch Services, a shared profile silently mixes accounts.
    local existing existing_scheme
    for existing in "$INSTANCES_ROOT"/*(N/); do
        [[ "$(config_value "$existing" DOPPEL_BUNDLE_ID)" != "$bundle_id" ]] || \
            die "bundle id '$bundle_id' is already used by instance '${existing:t}'"
        existing_scheme="$(config_value "$existing" DOPPEL_URL_SCHEME)"
        [[ "${existing_scheme:l}" != "${scheme:l}" ]] || \
            die "URL scheme '$scheme' is already used by instance '${existing:t}'"
        [[ "$(config_value "$existing" DOPPEL_PROFILE_ROOT)" != "$profile_root" ]] || \
            die "profile root '$profile_root' is already used by instance '${existing:t}'"
    done

    compile_helpers
    # Anything that goes wrong from here leaves a half-built instance
    # directory. One without a config used to wedge the slug and take every
    # later command down with it, so the partial directory is cleaned up
    # instead of left to be discovered later.
    PARTIAL_INSTANCE_DIR="$INSTANCES_ROOT/$slug"
    trap 'remove_partial_instance' EXIT INT TERM

    local dir
    dir="$(assemble_instance "$slug" "$name" "$bundle_id" "$scheme" "$profile_root" "$codex_home" "$tint" "$icon_override")"
    print -r -- "$install_to" > "$dir/install-root"
    mkdir -p "$install_to"
    /bin/zsh "$dir/doppel-engine.zsh" install "$install_to/$name.app"

    PARTIAL_INSTANCE_DIR=""
    print -r -- "created: $install_to/$name.app (instance assets: $dir)"
}

typeset -g PARTIAL_INSTANCE_DIR=""
remove_partial_instance() {
    [[ -n "$PARTIAL_INSTANCE_DIR" && -d "$PARTIAL_INSTANCE_DIR" ]] || return 0
    /bin/rm -rf "$PARTIAL_INSTANCE_DIR"
    print -u2 -r -- "doppel: cleaned up the partly created instance at $PARTIAL_INSTANCE_DIR"
}

cmd_list() {
    # --porcelain: stable machine-readable output, one instance per line:
    # slug<TAB>name<TAB>app-path<TAB>installed|missing<TAB>tint<TAB>clone|vendor
    # Instance names cannot contain tabs (create validates them), so tab-
    # separated fields are unambiguous. The menu-bar app consumes this instead
    # of parsing config files itself, so the CLI stays the single source of truth.
    local porcelain=0
    [[ "${1:-}" == "--porcelain" ]] && porcelain=1
    [[ -d "$INSTANCES_ROOT" ]] || { (( porcelain )) || print "no instances"; return 0 }
    local dir name app state engine
    for dir in "$INSTANCES_ROOT"/*(N/); do
        name="$(config_value "$dir" DOPPEL_DISPLAY_NAME)"
        [[ -n "$name" ]] || continue
        app="$(app_path_for "$dir")"
        [[ -d "$app" ]] && state="installed" || state="missing"
        engine="clone"
        instance_uses_vendor_engine "$dir" && engine="vendor"
        if (( porcelain )); then
            printf '%s\t%s\t%s\t%s\t%s\t%s\n' "${dir:t}" "$name" "$app" "$state" \
                "$(config_value "$dir" DOPPEL_TINT)" "$engine"
        elif [[ "$state" == "installed" && "$engine" == "vendor" ]]; then
            print -r -- "$name  ->  $app  [built-in browser]"
        elif [[ "$state" == "installed" ]]; then
            print -r -- "$name  ->  $app"
        elif [[ "$engine" == "vendor" ]]; then
            print -r -- "$name  ->  (not installed)  [built-in browser]"
        else
            print -r -- "$name  ->  (not installed)"
        fi
    done
}

# MARK: - Remodex bridge target

remodex_binary() {
    local candidate=""
    if [[ "${DOPPEL_DEV:-0}" == "1" && -n "${DOPPEL_REMODEX_BIN:-}" ]]; then
        candidate="${DOPPEL_REMODEX_BIN:a}"
    else
        candidate="$(command -v remodex 2>/dev/null || true)"
        [[ -n "$candidate" ]] && candidate="${candidate:a}"
        if [[ -z "$candidate" ]]; then
            local known
            for known in \
                "$HOME/.local/bin/remodex" \
                "$HOME/.npm/bin/remodex" \
                /opt/homebrew/bin/remodex \
                /usr/local/bin/remodex; do
                if [[ -x "$known" ]]; then
                    # Keep the executable path rather than resolving its npm
                    # symlink: Node normally lives beside the global shim.
                    candidate="${known:a}"
                    break
                fi
            done
        fi
    fi
    [[ -n "$candidate" && -x "$candidate" ]] || return 1
    print -r -- "$candidate"
}

run_remodex() {
    local bridge="$1"
    shift
    # npm's executable normally uses `#!/usr/bin/env node`. Menu-bar apps get
    # a restricted PATH, so include the bridge directory for its sibling Node
    # binary without changing or interpolating any target arguments.
    PATH="${bridge:h}:$PATH" "$bridge" "$@"
}

validate_remodex_instance_target() {
    local dir="$1" app="$2" expected_bundle="$3" expected_scheme="$4"
    [[ -d "$app" ]] || die "the managed app is missing: $app"
    [[ -d "$(config_value "$dir" DOPPEL_CODEX_HOME)" ]] || \
        die "the instance Codex home is missing; launch the instance once before assigning Remodex"
    local info="$app/Contents/Info.plist" actual_bundle schemes
    actual_bundle="$(/usr/bin/plutil -extract CFBundleIdentifier raw "$info" 2>/dev/null || true)"
    [[ "$actual_bundle" == "$expected_bundle" ]] || \
        die "the installed app bundle is '$actual_bundle', expected '$expected_bundle'; rebuild the instance first"
    schemes="$(/usr/bin/plutil -extract CFBundleURLTypes json -o - "$info" 2>/dev/null || true)"
    [[ -n "$schemes" ]] || die "the installed app has no readable URL schemes: $app"
    print -rn -- "$schemes" | /usr/bin/grep -Fq -- "\"$expected_scheme\"" || \
        die "the installed app does not register the '$expected_scheme' URL scheme; rebuild it first"
}

cmd_remodex_use() {
    [[ $# -eq 1 && -n "$1" ]] || die "usage: doppel remodex use <instance>"
    local dir app bundle scheme codex_home bridge
    dir="$(instance_dir_for "$1")"
    app="$(app_path_for "$dir")"
    bundle="$(config_value "$dir" DOPPEL_BUNDLE_ID)"
    scheme="$(config_value "$dir" DOPPEL_URL_SCHEME)"
    codex_home="$(config_value "$dir" DOPPEL_CODEX_HOME)"
    validate_remodex_instance_target "$dir" "$app" "$bundle" "$scheme"
    bridge="$(remodex_binary)" || die "Remodex is not installed; install the patched bridge before assigning an instance"
    run_remodex "$bridge" target set \
        --codex-home "$codex_home" \
        --bundle-id "$bundle" \
        --app-path "$app" \
        --url-scheme "$scheme" \
        --restart || die "Remodex could not switch targets; its previous target was restored"
    print -r -- "Remodex now targets $(config_value "$dir" DOPPEL_DISPLAY_NAME)."
}

remodex_json_field() {
    local json="$1" key="$2"
    print -rn -- "$json" | /usr/bin/plutil -extract "$key" raw -o - - 2>/dev/null || true
}

cmd_remodex_status() {
    local porcelain=0
    [[ "${1:-}" == "--porcelain" ]] && { porcelain=1; shift; }
    [[ $# -eq 0 ]] || die "usage: doppel remodex status [--porcelain]"
    local bridge json home bundle app scheme configured_fingerprint active_fingerprint launch_state
    bridge="$(remodex_binary)" || {
        (( porcelain )) && { print -r -- $'unavailable\t\t\t\t\t\t'; return 0; }
        die "Remodex is not installed"
    }
    json="$(run_remodex "$bridge" status --json 2>/dev/null)" || {
        (( porcelain )) && { print -r -- $'unavailable\t\t\t\t\t\t'; return 0; }
        die "Remodex status is unavailable"
    }
    home="$(remodex_json_field "$json" daemonConfig.codexHome)"
    bundle="$(remodex_json_field "$json" daemonConfig.codexBundleId)"
    app="$(remodex_json_field "$json" daemonConfig.codexAppPath)"
    scheme="$(remodex_json_field "$json" daemonConfig.codexUrlScheme)"
    configured_fingerprint="$(remodex_json_field "$json" daemonConfig.codexTargetFingerprint)"
    active_fingerprint="$(remodex_json_field "$json" bridgeStatus.codexTargetFingerprint)"
    launch_state="$(remodex_json_field "$json" bridgeStatus.codexLaunchState)"
    if [[ -z "$configured_fingerprint" ]]; then
        (( porcelain )) && { print -r -- $'unsupported\t\t\t\t\t\t'; return 0; }
        die "the installed Remodex does not support configurable desktop targets"
    fi
    local state="configured" slug="" name="" dir
    [[ "$configured_fingerprint" == "$active_fingerprint" && "$launch_state" == "connected" ]] && state="active"
    for dir in "$INSTANCES_ROOT"/*(N/); do
        [[ "$(config_value "$dir" DOPPEL_CODEX_HOME)" == "$home" ]] || continue
        [[ "$(config_value "$dir" DOPPEL_BUNDLE_ID)" == "$bundle" ]] || continue
        [[ "$(app_path_for "$dir")" == "$app" ]] || continue
        [[ "$(config_value "$dir" DOPPEL_URL_SCHEME)" == "$scheme" ]] || continue
        slug="${dir:t}"
        name="$(config_value "$dir" DOPPEL_DISPLAY_NAME)"
        break
    done
    if (( porcelain )); then
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$state" "$slug" "$name" "$home" "$bundle" "$app" "$scheme"
    elif [[ -n "$name" ]]; then
        print -r -- "Remodex: $state — $name"
    else
        print -r -- "Remodex: $state — primary or external target ($bundle, $home)"
    fi
}

cmd_remodex_release() {
    [[ $# -eq 0 ]] || die "usage: doppel remodex release"
    local bridge
    bridge="$(remodex_binary)" || die "Remodex is not installed"
    run_remodex "$bridge" target reset --restart || die "Remodex could not restore its primary target"
    print -r -- "Remodex now targets primary ChatGPT."
}

cmd_remodex() {
    local action="${1:-}"
    (( $# > 0 )) && shift
    case "$action" in
        use) cmd_remodex_use "$@" ;;
        status) cmd_remodex_status "$@" ;;
        release) cmd_remodex_release "$@" ;;
        *) die "usage: doppel remodex {use <instance>|status [--porcelain]|release}" ;;
    esac
}

cmd_launch() {
    local dir
    dir="$(instance_dir_for "$1")"
    if instance_uses_vendor_engine "$dir"; then
        launch_vendor_instance "$dir"
        return 0
    fi
    launch_clone_instance "$dir"
}

# Entry point used only by the signature-validated launcher embedded in a
# managed app. It re-resolves the current assignment under the global lock. A
# slot move that happened after the first process started therefore selects the
# current engine safely instead of recursing or opening both engines.
cmd_route_launch() {
    local dir
    dir="$(instance_dir_for "$1")"
    shift
    if instance_uses_vendor_engine "$dir"; then
        launch_vendor_instance "$dir" "$@"
    else
        launch_clone_instance "$dir" "$@"
    fi
}

cmd_browser_assign() {
    local quit_running=0
    if [[ "${1:-}" == "--quit-running" ]]; then
        quit_running=1
        shift
    fi
    [[ $# -eq 1 && -n "$1" ]] || \
        die "usage: doppel browser assign [--quit-running] <name>"
    local dir name current_slug current_dir current_name target_vendor_pids target_pid
    local -i current_running=0 target_clone_running=0 other_vendor_running=0
    dir="$(instance_dir_for "$1")"
    name="$(config_value "$dir" DOPPEL_DISPLAY_NAME)"
    validate_vendor_app "$PRIMARY_APP" || \
        die "the official ChatGPT engine is missing or is not valid OpenAI-signed code"
    target_vendor_pids="$(raw_vendor_profile_pids "$dir")"
    if [[ -n "$target_vendor_pids" ]]; then
        # Adoption does not execute the fallback router: the verified official
        # process already owns the profile. Accept a supported, self-consistent
        # released router here so updating Doppel does not force that working
        # Browser window to close merely because the manager CLI changed.
        require_compatible_transparent_router_profile "$dir"
    else
        require_transparent_router_profile "$dir"
    fi

    current_slug="$(iab_slot_slug)"
    if [[ "$current_slug" == "${dir:t}" ]]; then
        # A normal Finder/Dock launch of the official app can already be using
        # this managed profile without a Doppel receipt. Adopt that exact live
        # process instead of telling the user to quit a working Browser.
        if [[ -n "$target_vendor_pids" ]] && ! clone_instance_is_running "$dir" && \
           ! other_vendor_engine_is_running "$dir"; then
            local -a matching_target_pids
            matching_target_pids=("${(f)target_vendor_pids}")
            (( ${#matching_target_pids} == 1 )) || \
                die "the Browser assignment needs running ChatGPT apps to quit: more than one official ChatGPT process is using '$name'."
            target_pid="${matching_target_pids[1]}"
            write_iab_runtime_receipt "${dir:t}" "$target_pid" "$(primary_version)"
            print -r -- "built-in browser already assigned to and adopted from: $name"
            return 0
        fi
        print -r -- "built-in browser already assigned to: $name"
        return 0
    fi
    if [[ -n "$current_slug" ]]; then
        current_dir="$INSTANCES_ROOT/$current_slug"
        # Once the slot moves, this profile's next launch uses its fallback
        # clone. Do not return it to an older Electron build.
        require_vendor_compatible_profile "$current_dir"
        current_name="$(config_value "$current_dir" DOPPEL_DISPLAY_NAME)"
        any_chatgpt_process_uses_profile "$current_dir" && current_running=1
    fi

    clone_instance_is_running "$dir" && target_clone_running=1
    other_vendor_engine_is_running "$dir" && other_vendor_running=1

    # If the target is already the one official ChatGPT process, assignment is
    # just adoption: write the slot and bind a receipt to that PID/start time.
    # This is the common Veridue case because it owns the vendor default root.
    if [[ -n "$target_vendor_pids" ]] && (( ! current_running && ! target_clone_running && ! other_vendor_running )); then
        local -a matching_target_pids
        matching_target_pids=("${(f)target_vendor_pids}")
        if (( ${#matching_target_pids} == 1 )); then
            target_pid="${matching_target_pids[1]}"
            write_iab_slot "${dir:t}"
            write_iab_runtime_receipt "${dir:t}" "$target_pid" "$(primary_version)"
            print -r -- "built-in browser assigned to and adopted from: $name"
            return 0
        fi
    fi

    if (( current_running || target_clone_running || other_vendor_running )) || \
       [[ -n "$target_vendor_pids" ]]; then
        if (( ! quit_running )); then
            if (( current_running )); then
                die "the Browser assignment needs running ChatGPT apps to quit: '$current_name' is still using a ChatGPT engine."
            elif (( target_clone_running )); then
                die "the Browser assignment needs running ChatGPT apps to quit: '$name' is running through its Doppel engine."
            else
                die "the Browser assignment needs running ChatGPT apps to quit: an official ChatGPT process is using another or ambiguous profile."
            fi
        fi

        # This path is opt-in from the CLI, and the menu presents a confirmation
        # first. Quit only the official vendor app and the two managed profiles
        # involved in this transition; unrelated Doppel clones stay open.
        if [[ -n "$(vendor_main_pids)" ]]; then
            quit_instance "$PRIMARY_APP" "$PRIMARY_BUNDLE_ID" "ChatGPT"
        fi
        if [[ -n "$current_dir" ]] && clone_instance_is_running "$current_dir"; then
            quit_instance "$(app_path_for "$current_dir")" \
                "$(config_value "$current_dir" DOPPEL_BUNDLE_ID)" "$current_name"
        fi
        if clone_instance_is_running "$dir"; then
            quit_instance "$(app_path_for "$dir")" \
                "$(config_value "$dir" DOPPEL_BUNDLE_ID)" "$name"
        fi
        [[ -z "$(vendor_main_pids)" ]] || \
            die "ChatGPT is still running, so the built-in browser assignment was not changed."
        any_chatgpt_process_uses_profile "$dir" && \
            die "'$name' is still running, so the built-in browser assignment was not changed."
        [[ -z "$current_dir" ]] || ! any_chatgpt_process_uses_profile "$current_dir" || \
            die "'$current_name' is still running, so the built-in browser assignment was not changed."
    fi

    write_iab_slot "${dir:t}"
    print -r -- "built-in browser assigned to: $name"
}

cmd_browser_release() {
    [[ $# -eq 0 ]] || die "usage: doppel browser release"
    local slug dir name
    slug="$(iab_slot_slug)"
    if [[ -z "$slug" ]]; then
        if [[ -e "$IAB_SLOT_FILE" ]]; then
            clear_iab_slot
            print -r -- "cleared invalid built-in-browser assignment"
        else
            print -r -- "built-in browser is not assigned"
        fi
        return 0
    fi
    dir="$INSTANCES_ROOT/$slug"
    name="$(config_value "$dir" DOPPEL_DISPLAY_NAME)"
    any_chatgpt_process_uses_profile "$dir" && \
        die "'$name' is using a ChatGPT engine. Quit it before releasing the built-in browser."
    require_vendor_compatible_profile "$dir"
    clear_iab_slot
    print -r -- "built-in browser released from: $name"
}

cmd_browser_status() {
    local porcelain=0 slug dir name state signature runtime_kind runtime_slug runtime_name runtime_pid
    if [[ "${1:-}" == "--porcelain" ]]; then
        porcelain=1; shift
    fi
    [[ $# -eq 0 ]] || die "usage: doppel browser status [--porcelain]"
    IFS=$'\t' read -r runtime_kind runtime_slug runtime_name runtime_pid \
        <<< "$(vendor_runtime_snapshot)"
    slug="$(iab_slot_slug)"
    if [[ -z "$slug" ]]; then
        if (( porcelain )); then
            if [[ "$runtime_kind" == "none" ]]; then
                print -r -- "unassigned"
            else
                printf 'unassigned\t%s\t%s\t%s\n' "$runtime_kind" "$runtime_slug" "$runtime_name"
            fi
        elif [[ "$runtime_kind" == "managed" ]]; then
            print -r -- "Built-in browser: not assigned; official ChatGPT is currently using $runtime_name"
        elif [[ "$runtime_kind" != "none" ]]; then
            print -r -- "Built-in browser: not assigned; another official ChatGPT process is running ($runtime_name)"
        else
            print -r -- "Built-in browser: not assigned"
        fi
        return 0
    fi
    dir="$INSTANCES_ROOT/$slug"
    name="$(config_value "$dir" DOPPEL_DISPLAY_NAME)"
    if [[ "$runtime_kind" != "none" && \
          ( "$runtime_kind" != "managed" || "$runtime_slug" != "$slug" ) ]]; then
        state="conflict"
    elif vendor_instance_is_running "$dir"; then
        state="running"
    elif [[ "$runtime_kind" == "managed" && "$runtime_slug" == "$slug" ]]; then
        state="untracked"
    else
        state="stopped"
    fi
    validate_vendor_app "$PRIMARY_APP" && signature="valid" || signature="invalid"
    if (( porcelain )); then
        printf 'assigned\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$slug" "$name" "$state" "$signature" "$PRIMARY_APP" \
            "$runtime_kind" "$runtime_slug" "$runtime_name"
    elif [[ "$state" == "conflict" ]]; then
        print -r -- "Built-in browser: assigned to $name, but official ChatGPT is currently using $runtime_name"
    elif [[ "$state" == "untracked" ]]; then
        print -r -- "Built-in browser: $name (running outside Doppel; official engine signature $signature)"
    else
        print -r -- "Built-in browser: $name ($state; official engine signature $signature)"
    fi
}

cmd_browser() {
    local action="${1:-status}"
    (( $# > 0 )) && shift
    case "$action" in
        assign) with_iab_operation_lock cmd_browser_assign "$@" ;;
        release) with_iab_operation_lock cmd_browser_release "$@" ;;
        status) cmd_browser_status "$@" ;;
        *) die "usage: doppel browser {assign [--quit-running] <name>|release|status [--porcelain]}" ;;
    esac
}

# Removal never deletes: the app bundle goes to the Trash and the instance
# definition is kept under state/Removed, so a removal can be undone. Account
# data (profile + CODEX_HOME) is left untouched unless --purge-data is given,
# and even then it is moved to the Trash rather than erased.
cmd_remove() {
    local target="" purge=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --purge-data) purge=1; shift ;;
            -*) die "unknown option: $1" ;;
            *) target="$1"; shift ;;
        esac
    done
    [[ -n "$target" ]] || die "usage: doppel remove <name> [--purge-data]"

    local dir app bundle_id profile_root codex_home was_iab=0
    dir="$(instance_dir_for "$target")"
    app="$(app_path_for "$dir")"
    bundle_id="$(config_value "$dir" DOPPEL_BUNDLE_ID)"
    profile_root="$(config_value "$dir" DOPPEL_PROFILE_ROOT)"
    codex_home="$(config_value "$dir" DOPPEL_CODEX_HOME)"
    if any_chatgpt_process_uses_profile "$dir" && ! clone_instance_is_running "$dir"; then
        die "'$target' is using another ChatGPT engine. Quit that window before removing the profile."
    fi
    if instance_uses_vendor_engine "$dir"; then
        was_iab=1
        vendor_instance_is_running "$dir" && \
            die "'$target' is using the official ChatGPT engine. Quit it before removing the profile."
    fi

    # An instance can be pointed at any directory, including one it does not
    # own: the primary app's own profile, a shared CODEX_HOME, or a home
    # directory. Purging is checked before anything at all is moved, so a
    # refusal costs nothing and the answer is never "half of it went".
    if (( purge )); then
        local data
        for data in "$profile_root" "$codex_home"; do
            [[ -n "$data" ]] || continue
            ! protected_data_path "$data" || \
                die "refusing to purge $data: it is a shared or system location, not a directory this instance owns. Remove '$target' without --purge-data, then delete anything you actually want gone yourself."
            ! data_shared_with_other_instance "$data" "$dir" || \
                die "refusing to purge $data: another instance is using it. Remove '$target' without --purge-data."
        done
    fi

    quit_instance "$app" "$bundle_id" "$target"
    any_chatgpt_process_uses_profile "$dir" && \
        die "'$target''s profile is still open through another ChatGPT process; no app or account data was moved."

    # Clear before moving the definition. If power is lost after the move but
    # before a later clear, recreating the same slug must not resurrect an old
    # browser-engine assignment.
    if (( was_iab )); then
        clear_iab_slot
    fi

    local stamp="$(/bin/date '+%Y%m%d-%H%M%S')"
    local trash="$HOME/.Trash"
    mkdir -p "$trash"

    if [[ -d "$app" ]]; then
        "$LSREGISTER" -u "$app" >/dev/null 2>&1 || true
        /bin/mv "$app" "$trash/${app:t:r}.$stamp.app" || die "moving the app bundle to the Trash failed"
        forget_pinned_requirement "$app"
        print -r -- "moved to Trash: ${app:t}"
    fi

    local removed_root="$DOPPEL_HOME/state/Removed"
    mkdir -p "$removed_root"
    /bin/mv "$dir" "$removed_root/${dir:t}.$stamp" || die "preserving the instance definition failed"
    print -r -- "instance definition kept at: $removed_root/${dir:t}.$stamp"

    if (( purge )); then
        for data in "$profile_root" "$codex_home"; do
            [[ -n "$data" && -d "$data" ]] || continue
            /bin/mv "$data" "$trash/${data:t}.$stamp" || die "moving $data to the Trash failed"
            print -r -- "moved to Trash: ${data:t}"
        done
    else
        print -r -- "account data left in place (pass --purge-data to move it to the Trash):"
        [[ -n "$profile_root" ]] && print -r -- "  $profile_root"
        [[ -n "$codex_home" ]] && print -r -- "  $codex_home"
    fi
}

# Renames an instance and/or changes its icon colour. Identity and data stay
# put: the slug, bundle id, URL scheme and profile paths are all fixed at
# creation, so a rename never orphans an account's chats or login.
cmd_edit() {
    local target="" new_name="" tint="" icon_override=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --rename) new_name="$2"; shift 2 ;;
            --tint) tint="$2"; shift 2 ;;
            --original-icon) tint="original"; shift ;;
            --icon) icon_override="$2"; shift 2 ;;
            -*) die "unknown option: $1" ;;
            *) target="$1"; shift ;;
        esac
    done
    [[ -n "$target" ]] || \
        die "usage: doppel edit <name> [--rename <new name>] [--tint RRGGBB|--original-icon] [--icon path.icns]"
    [[ -n "$new_name" || -n "$tint" || -n "$icon_override" ]] || \
        die "nothing to change; pass --rename, --tint, --original-icon or --icon"

    local dir old_app bundle_id uses_vendor=0
    dir="$(instance_dir_for "$target")"
    instance_uses_vendor_engine "$dir" && uses_vendor=1
    old_app="$(app_path_for "$dir")"
    bundle_id="$(config_value "$dir" DOPPEL_BUNDLE_ID)"

    # Everything that can refuse the rename is checked here, before a single
    # byte changes. Deciding halfway through used to leave the config renamed
    # and the bundle not, which read as an instance that had lost its app.
    local new_app="$old_app"
    if [[ -n "$new_name" ]]; then
        validate_name "$new_name"
        local existing existing_name new_slug
        new_slug="$(slugify "$new_name")"
        [[ -n "$new_slug" ]] || die "the name produces an empty identifier; include at least one letter or digit"
        for existing in "$INSTANCES_ROOT"/*(N/); do
            [[ "$existing" != "$dir" ]] || continue
            existing_name="$(config_value "$existing" DOPPEL_DISPLAY_NAME)"
            [[ "$existing_name" != "$new_name" ]] || \
                die "another instance is already called '$new_name'"
            # Names that differ but slugify the same are indistinguishable to
            # every command that takes a name, so one of the two would become
            # unreachable.
            [[ "${existing:t}" != "$new_slug" ]] || \
                die "'$new_name' is too close to '$existing_name'; they would share the identifier '$new_slug'"
        done
        local install_root
        install_root="$(cat "$dir/install-root" 2>/dev/null || print -r -- "$HOME/Applications")"
        new_app="$install_root/$new_name.app"
        [[ "$new_app" == "$old_app" || ! -e "$new_app" ]] || \
            die "an app already exists at $new_app; pick another name or move that app aside first"
    fi

    # The bundle is replaced in place, so the running copy has to go first. It
    # is reopened afterwards only if it was open to begin with.
    local was_running=0
    clone_instance_is_running "$dir" && was_running=1
    quit_instance "$old_app" "$bundle_id" "$target"
    if (( was_running )); then
        if (( uses_vendor )); then
            if any_chatgpt_process_uses_profile "$dir" && \
               ! vendor_instance_is_running "$dir"; then
                die "'$target''s profile is still open through another ChatGPT process; its fallback clone was not changed or reopened."
            fi
        else
            any_chatgpt_process_uses_profile "$dir" && \
                die "'$target''s profile is still open through another ChatGPT process; its fallback clone was not changed or reopened."
        fi
    fi
    if [[ -n "$tint" || -n "$icon_override" ]]; then
        generate_icon "$dir" "$tint" "$icon_override"
    fi

    local effective_name effective_tint
    effective_name="${new_name:-$(config_value "$dir" DOPPEL_DISPLAY_NAME)}"
    if [[ -n "$icon_override" ]]; then
        effective_tint=""
    else
        effective_tint="${tint:-$(config_value "$dir" DOPPEL_TINT)}"
    fi
    write_config "$dir" "$effective_name" "$bundle_id" \
        "$(config_value "$dir" DOPPEL_URL_SCHEME)" \
        "$(config_value "$dir" DOPPEL_PROFILE_ROOT)" \
        "$(config_value "$dir" DOPPEL_CODEX_HOME)" \
        "$effective_tint"

    if [[ "$new_app" != "$old_app" && -d "$old_app" ]]; then
        "$LSREGISTER" -u "$old_app" >/dev/null 2>&1 || true
        /bin/mv "$old_app" "$new_app" || die "renaming the app bundle failed"
        forget_pinned_requirement "$old_app"
    fi

    # A rename or recolour only touches metadata and artwork, so the bundle is
    # restyled in place: no 200MB copy, and the vendor executable is left
    # byte-identical, which matters because macOS binds keychain and privacy
    # permissions to code identity. Compiling helpers is only needed if that
    # fails and a full rebuild has to run.
    install_router_assets "$dir"
    # DOPPEL_NO_ALERT: a restyle that cannot apply is a normal outcome — the
    # bundle predates the current engine, say — and must not raise a dialog.
    local restyle_error
    if restyle_error="$(DOPPEL_NO_ALERT=1 /bin/zsh "$dir/doppel-engine.zsh" restyle "$new_app" 2>&1)"; then
        :
    else
        print -r -- "rebuilding instead of restyling: ${restyle_error##*: }"
        compile_helpers
        install_engine_assets "$dir"
        /bin/zsh "$dir/doppel-engine.zsh" install "$new_app"
    fi
    refresh_icon_caches "$new_app"
    if (( was_running )) && [[ "${DOPPEL_RELAUNCH:-1}" != "0" ]]; then
        if (( uses_vendor )); then
            launch_vendor_instance "$dir"
        else
            launch_clone_instance "$dir"
        fi
    fi
    print -r -- "updated: $new_app"
}

cmd_rebuild() {
    local dir app bundle_id was_running=0 uses_vendor=0 vendor_was_running=0 engine_output
    dir="$(instance_dir_for "$1")"
    instance_uses_vendor_engine "$dir" && uses_vendor=1
    app="$(app_path_for "$dir")"
    bundle_id="$(config_value "$dir" DOPPEL_BUNDLE_ID)"
    if (( uses_vendor )); then
        vendor_instance_is_running "$dir" && vendor_was_running=1
        if any_chatgpt_process_uses_profile "$dir" && \
           (( vendor_was_running == 0 )) && ! clone_instance_is_running "$dir"; then
            die "'$1' is using another ChatGPT engine. Quit that window before rebuilding its fallback clone."
        fi
        clone_instance_is_running "$dir" && \
            die "'$1' is unexpectedly running through both engine states. Quit its Doppel window before rebuilding; the official engine was left untouched."
    else
        clone_instance_is_running "$dir" && was_running=1
        (( was_running )) && quit_instance "$app" "$bundle_id" "$1"
        any_chatgpt_process_uses_profile "$dir" && \
            die "'$1''s profile is still open through another ChatGPT process. Quit it before rebuilding."
    fi
    prepare_rebuild_primary
    trap 'release_rebuild_primary' EXIT INT TERM
    compile_helpers
    install_engine_assets "$dir"
    engine_output="$(DOPPEL_PRIMARY_APP="$REBUILD_PRIMARY_APP" \
        /bin/zsh "$dir/doppel-engine.zsh" install "$app")"
    release_rebuild_primary
    trap - EXIT INT TERM
    refresh_icon_caches "$app"
    # A rebuild selected by the user is also a request to use the rebuilt app.
    # Relaunch even when the caller had to quit a scheduled-task warning before
    # retrying; otherwise that confirmation loses the original running state
    # and a successful rebuild appears to do nothing. Automated maintenance can
    # still opt out explicitly with DOPPEL_RELAUNCH=0.
    if [[ "${DOPPEL_RELAUNCH:-1}" != "0" ]]; then
        if (( uses_vendor && vendor_was_running )); then
            : # Rebuild never interrupts an already-running vendor engine.
        elif (( uses_vendor )); then
            launch_vendor_instance "$dir"
        else
            launch_clone_instance "$dir"
        fi
    fi
    # A rebuild of a bundle that is already in step does nothing, and saying
    # "rebuilt" anyway made a no-op look like a repair.
    if [[ "$engine_output" == *already-healthy* ]]; then
        if [[ "${DOPPEL_RELAUNCH:-1}" != "0" ]]; then
            if (( uses_vendor && vendor_was_running )); then
                print -r -- "already up to date; official engine left running: $app"
            elif (( uses_vendor )); then
                print -r -- "already up to date; opened with built-in browser: $app"
            else
                print -r -- "already up to date and reopened: $app"
            fi
        else
            print -r -- "already up to date: $app"
        fi
    else
        if [[ "${DOPPEL_RELAUNCH:-1}" != "0" ]]; then
            if (( uses_vendor && vendor_was_running )); then
                print -r -- "rebuilt fallback clone; official engine left running: $app"
            elif (( uses_vendor )); then
                print -r -- "rebuilt fallback clone; opened with built-in browser: $app"
            else
                print -r -- "rebuilt and reopened: $app"
            fi
        else
            print -r -- "rebuilt: $app"
        fi
    fi
}

# Recent OpenAI installers can validate while mounted inside their notarized
# disk image yet fail the older standalone strict check after Finder copies the
# byte-identical app into /Applications. Keep rebuilds fail-closed: when the
# installed primary is not acceptable, use only an exact-build DMG that Doppel
# previously verified and preserved under updates/Official/<build>/ChatGPT.dmg.
# The image is checksum-verified, mounted read-only, and its app must still pass
# the normal bundle ID, build, Team ID and strict nested-signature checks.
typeset -g REBUILD_PRIMARY_APP=""
typeset -g REBUILD_PRIMARY_MOUNT=""
typeset -g REBUILD_PRIMARY_DEVICE=""

release_rebuild_primary() {
    [[ -n "$REBUILD_PRIMARY_MOUNT" ]] || return 0
    if [[ -n "$REBUILD_PRIMARY_DEVICE" ]]; then
        /usr/bin/hdiutil detach "$REBUILD_PRIMARY_DEVICE" >/dev/null 2>&1 || \
            print -u2 -r -- "doppel: warning: could not unmount $REBUILD_PRIMARY_MOUNT"
    fi
    /bin/rmdir "$REBUILD_PRIMARY_MOUNT" 2>/dev/null || true
    REBUILD_PRIMARY_APP=""
    REBUILD_PRIMARY_MOUNT=""
    REBUILD_PRIMARY_DEVICE=""
}

prepare_rebuild_primary() {
    REBUILD_PRIMARY_APP="$PRIMARY_APP"
    REBUILD_PRIMARY_MOUNT=""
    REBUILD_PRIMARY_DEVICE=""
    validate_vendor_app "$PRIMARY_APP" && return 0

    local version dmg mount attach_output device mounted_app
    version="$(primary_version)"
    valid_build_number "$version" || \
        die "the installed primary is not valid vendor-signed code and its build number could not be read"
    dmg="$UPDATE_ROOT/Official/$version/ChatGPT.dmg"
    [[ -f "$dmg" ]] || \
        die "the installed primary signature is invalid and no verified official installer is cached for build $version"
    /usr/bin/hdiutil verify "$dmg" >/dev/null 2>&1 || \
        die "the cached official ChatGPT installer failed its disk-image checksum"
    mount="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/doppel-primary.XXXXXXXX")" || \
        die "a temporary mount point for the official ChatGPT installer could not be created"
    if ! attach_output="$(/usr/bin/hdiutil attach -readonly -nobrowse -mountpoint "$mount" "$dmg")"; then
        /bin/rmdir "$mount" 2>/dev/null || true
        die "the cached official ChatGPT installer could not be mounted read-only"
    fi
    device="$(print -r -- "$attach_output" | /usr/bin/awk -v target="$mount" '$NF == target { print $1; exit }')"
    if [[ "$device" != /dev/disk* ]]; then
        /usr/bin/hdiutil detach "$mount" >/dev/null 2>&1 || true
        /bin/rmdir "$mount" 2>/dev/null || true
        die "the official ChatGPT installer mounted on an unexpected device"
    fi
    REBUILD_PRIMARY_MOUNT="$mount"
    REBUILD_PRIMARY_DEVICE="$device"
    mounted_app="$mount/ChatGPT.app"
    if ! validate_vendor_app "$mounted_app" "$version"; then
        release_rebuild_primary
        die "the app inside the cached official installer failed vendor verification"
    fi
    REBUILD_PRIMARY_APP="$mounted_app"
    print -r -- "using verified official installer for ChatGPT build $version"
}

# MARK: - Primary-first coordinated updates

primary_version() {
    /usr/bin/plutil -extract CFBundleVersion raw "$PRIMARY_APP/Contents/Info.plist" 2>/dev/null || true
}

primary_short_version() {
    /usr/bin/plutil -extract CFBundleShortVersionString raw "$PRIMARY_APP/Contents/Info.plist" 2>/dev/null || true
}

# The vendor build a managed instance's app was cloned from. Empty when the app
# is missing or predates the marker.
instance_source_build() {
    /usr/bin/plutil -extract DoppelSourceBundleVersion raw "$1/Contents/Info.plist" 2>/dev/null || true
}

# How many installed instances were built from a vendor build other than the one
# given, split by direction: behind first, then ahead.
#
# Deliberately cheaper than verify_managed_instance: this answers the update
# check, which the menu app runs on a timer, so it reads the build each app
# records rather than launching every instance. ChatGPT's own Sparkle updater
# can replace the primary on its own and never touches the instances, which then
# sit on the build they were cloned from with nothing left for Doppel to
# download.
#
# The two directions are counted apart because only one of them is an offer
# Doppel can make. Rebuilding an instance that is behind moves it to the app
# that is installed; rebuilding one that is ahead would hand a profile a later
# version already migrated back to an earlier one. A build this cannot read
# counts as behind: it is not one to trust as newer.
instance_build_drift() {
    local expected="$1" dir app recorded behind=0 ahead=0
    for dir in "$INSTANCES_ROOT"/*(N/); do
        is_instance_dir "$dir" || continue
        app="$(app_path_for "$dir")"
        [[ -d "$app" ]] || continue
        recorded="$(instance_source_build "$app")"
        if [[ "$recorded" == "$expected" ]]; then
            continue
        fi
        if valid_build_number "$recorded" && (( recorded > expected )); then
            ahead=$(( ahead + 1 ))
        else
            behind=$(( behind + 1 ))
        fi
    done
    printf '%s\t%s\n' "$behind" "$ahead"
}

valid_build_number() {
    [[ "$1" == <1-> ]]
}

# The requirement genuine vendor code has to satisfy, which is the vendor app's
# own designated requirement. `--verify` on its own only proves a signature
# seals the bundle it is attached to, which any locally made certificate can
# also do; the Apple anchor is what makes this mean "OpenAI signed it".
#
# The two marker OIDs are not decoration. Without them the requirement accepts
# any certificate Apple ever issued to that team, including an individual
# engineer's Apple Development certificate, which is far more widely held than
# the release key. 6.2.6 is the Developer ID intermediate CA; 6.1.13 is the
# Developer ID Application leaf. Kept identical to the engine's copy.
#
# Interpolated values are validated once at startup rather than here, because
# this runs inside a command substitution where `die` would only kill the
# subshell and leave the caller running with an empty requirement.
vendor_requirement() {
    print -r -- "=anchor apple generic and identifier \"$PRIMARY_BUNDLE_ID\"\
 and certificate 1[field.1.2.840.113635.100.6.2.6]\
 and certificate leaf[field.1.2.840.113635.100.6.1.13]\
 and certificate leaf[subject.OU] = \"$PRIMARY_TEAM_ID\""
}

validate_vendor_app() {
    local app="$1" expected_version="${2:-}" info actual_version
    info="$app/Contents/Info.plist"
    [[ -d "$app" && -f "$info" ]] || return 1
    [[ "$(/usr/bin/plutil -extract CFBundleIdentifier raw "$info" 2>/dev/null)" == "$PRIMARY_BUNDLE_ID" ]] || return 1
    actual_version="$(/usr/bin/plutil -extract CFBundleVersion raw "$info" 2>/dev/null)"
    valid_build_number "$actual_version" || return 1
    [[ -z "$expected_version" || "$actual_version" == "$expected_version" ]] || return 1
    # No `codesign -dv` text is parsed here on purpose. The old check searched
    # that output for TeamIdentifier=<team>, but the signing identifier is
    # echoed into the same stream, so one crafted identifier satisfied it. The
    # requirement checks the same field without reading attacker-shaped text.
    /usr/bin/codesign --verify --deep --strict \
        -R "$(vendor_requirement)" "$app" >/dev/null 2>&1 || return 1
    return 0
}

fetch_latest_update() {
    mkdir -p "$UPDATE_ROOT"
    local feed item arch version short_version url
    feed="$(/usr/bin/mktemp "$UPDATE_ROOT/appcast.XXXXXXXX")" || die "could not create an appcast work file"
    if ! /usr/bin/curl --fail --silent --show-error --location --max-time 45 \
        --retry 2 --retry-delay 2 "$APPCAST_URL" -o "$feed"; then
        /bin/rm -f "$feed"
        die "could not check OpenAI's ChatGPT update feed"
    fi
    arch="$(/usr/bin/uname -m)"
    item="(//*[local-name()='item'][not(*[local-name()='hardwareRequirements']) or *[local-name()='hardwareRequirements' and text()='$arch']])[1]"
    version="$(/usr/bin/xmllint --xpath "string($item/*[local-name()='version'])" "$feed" 2>/dev/null)"
    short_version="$(/usr/bin/xmllint --xpath "string($item/*[local-name()='shortVersionString'])" "$feed" 2>/dev/null)"
    url="$(/usr/bin/xmllint --xpath "string($item/*[local-name()='enclosure'][1]/@url)" "$feed" 2>/dev/null)"
    /bin/rm -f "$feed"
    valid_build_number "$version" || die "OpenAI's update feed did not contain a valid build number"
    [[ -n "$short_version" && "$short_version" != *$'\n'* && "$short_version" != *$'\t'* ]] || \
        die "OpenAI's update feed did not contain a valid version name"
    [[ "$url" == https://persistent.oaistatic.com/codex-app-prod/ChatGPT-darwin-*.zip ]] || \
        die "OpenAI's update feed returned an unexpected download location"
    printf '%s\t%s\t%s\n' "$version" "$short_version" "$url"
}

prepared_update_app() {
    local version="$1"
    valid_build_number "$version" || return 1
    print -r -- "$UPDATE_ROOT/Prepared/$version/ChatGPT.app"
}

update_metadata_value() {
    local version="$1" key="$2" metadata
    metadata="$UPDATE_ROOT/Prepared/$version/update.plist"
    /usr/bin/plutil -extract "$key" raw "$metadata" 2>/dev/null || true
}

# --porcelain prints one tab-separated line, append-only across versions:
#
#   1 state           current | available | ready | stale-instances
#   2 installed build
#   3 installed version
#   4 feed build
#   5 feed version
#   6 feed download URL
#   7 instances built from an older build than the installed one
#   8 instances built from a newer build than the installed one
#
# Columns 2-6 mean the same thing in every state; the state word is what says
# whether anything is worth doing. A reconcile targets the installed build in
# column 2, never the feed's, and only column 7 can produce one: an instance
# ahead of the primary is reported, never rebuilt backwards.
cmd_update_check() {
    local porcelain=0
    [[ "${1:-}" == "--porcelain" ]] && porcelain=1
    [[ -z "${1:-}" || "$porcelain" == "1" ]] || die "usage: doppel update check [--porcelain]"
    validate_vendor_app "$PRIMARY_APP" || die "the primary ChatGPT app is missing or is not valid vendor-signed code"
    local current current_short latest latest_version latest_short latest_url prepared update_state
    local drift stale ahead
    current="$(primary_version)"
    current_short="$(primary_short_version)"
    latest="$(fetch_latest_update)"
    IFS=$'\t' read -r latest_version latest_short latest_url <<< "$latest"
    update_state="current"
    stale=0
    ahead=0
    if (( latest_version > current )); then
        update_state="available"
        prepared="$(prepared_update_app "$latest_version")"
        if validate_vendor_app "$prepared" "$latest_version"; then
            update_state="ready"
        fi
    else
        # Nothing to download does not mean nothing to do: the vendor updater
        # moves the primary alone, so the instances can be behind a primary that
        # is itself current. Reported as its own state rather than folded into
        # "available", because the fix is a rebuild from the installed app.
        drift="$(instance_build_drift "$current")"
        IFS=$'\t' read -r stale ahead <<< "$drift"
        if (( stale > 0 )); then
            update_state="stale-instances"
        fi
    fi
    if (( porcelain )); then
        # The drift counts are appended so the six columns every earlier reader
        # expects keep their meaning: current is what is installed, latest is
        # what the feed offers. A reconcile targets the installed build.
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$update_state" "$current" "$current_short" "$latest_version" "$latest_short" "$latest_url" \
            "$stale" "$ahead"
        return 0
    fi
    if [[ "$update_state" == "stale-instances" ]]; then
        print -r -- "ChatGPT $current_short ($current) is up to date, but $stale managed instance(s) were built from an older version; run 'doppel update apply' to rebuild them."
    elif [[ "$update_state" == "current" ]]; then
        print -r -- "ChatGPT $current_short ($current) is up to date."
    elif [[ "$update_state" == "ready" ]]; then
        print -r -- "ChatGPT $latest_short ($latest_version) is downloaded and ready to install."
    else
        print -r -- "ChatGPT $latest_short ($latest_version) is available; current is $current_short ($current)."
    fi
    # Said plainly rather than folded into the count above: this one is not an
    # offer. Rebuilding an instance onto an older primary is a downgrade, so it
    # stays a decision someone makes per instance.
    if (( ahead > 0 )); then
        print -r -- "$ahead managed instance(s) were built from a newer build than the installed app; 'doppel update apply' leaves those alone. Use 'doppel rebuild <name>' to move one back to $current."
    fi
}

acquire_update_lock() {
    mkdir -p "$UPDATE_ROOT"
    if ! /bin/mkdir "$UPDATE_ROOT/Coordinator.lock" 2>/dev/null; then
        local owner
        owner="$(cat "$UPDATE_ROOT/Coordinator.lock/pid" 2>/dev/null || true)"
        if valid_build_number "$owner" && ! /bin/kill -0 "$owner" 2>/dev/null; then
            # A power loss or killed coordinator may leave the mkdir lock
            # behind. Remove only the exact lock after proving its owner is
            # gone, then take it normally.
            /bin/rm -f "$UPDATE_ROOT/Coordinator.lock/pid"
            /bin/rmdir "$UPDATE_ROOT/Coordinator.lock" 2>/dev/null || true
            /bin/mkdir "$UPDATE_ROOT/Coordinator.lock" 2>/dev/null || \
                die "another Doppel update is already in progress"
        else
            die "another Doppel update is already in progress"
        fi
    fi
    print -r -- "$$" > "$UPDATE_ROOT/Coordinator.lock/pid"
}

release_update_lock() {
    [[ -d "$UPDATE_ROOT/Coordinator.lock" ]] || return 0
    local owner
    owner="$(cat "$UPDATE_ROOT/Coordinator.lock/pid" 2>/dev/null || true)"
    [[ "$owner" == "$$" ]] || return 0
    /bin/rm -f "$UPDATE_ROOT/Coordinator.lock/pid"
    /bin/rmdir "$UPDATE_ROOT/Coordinator.lock" 2>/dev/null || true
}

typeset -g UPDATE_ABORT_MANIFEST=""
abort_update_cleanup() {
    local app dir
    if [[ -n "$UPDATE_ABORT_MANIFEST" && -f "$UPDATE_ABORT_MANIFEST" ]]; then
        while IFS= read -r app; do
            [[ -d "$app" ]] || continue
            /usr/bin/pgrep -f "${app}/Contents/MacOS/" >/dev/null 2>&1 && continue
            if [[ "$app" == "$PRIMARY_APP" ]]; then
                /usr/bin/open -na "$app" >/dev/null 2>&1 || true
            else
                dir="$(instance_dir_for_app_path "$app" 2>/dev/null || true)"
                [[ -n "$dir" ]] && ( launch_clone_instance "$dir" >/dev/null 2>&1 ) || true
            fi
        done < "$UPDATE_ABORT_MANIFEST"
    fi
    release_update_lock
}

cmd_update_prepare() {
    [[ $# -eq 0 ]] || die "usage: doppel update prepare"
    validate_vendor_app "$PRIMARY_APP" || die "the primary ChatGPT app is missing or is not valid vendor-signed code"
    local current latest latest_version latest_short latest_url prepared partial archive staging extracted metadata
    current="$(primary_version)"
    latest="$(fetch_latest_update)"
    IFS=$'\t' read -r latest_version latest_short latest_url <<< "$latest"
    (( latest_version > current )) || { print -r -- "already current\t$current"; return 0; }
    prepared="$(prepared_update_app "$latest_version")"
    if validate_vendor_app "$prepared" "$latest_version"; then
        print -r -- "ready\t$latest_version\t$latest_short"
        return 0
    fi

    acquire_update_lock
    trap 'release_update_lock' EXIT INT TERM
    mkdir -p "$UPDATE_ROOT/Downloads" "$UPDATE_ROOT/Staging" "$UPDATE_ROOT/Prepared"
    partial="$UPDATE_ROOT/Downloads/ChatGPT-$latest_version.zip.partial"
    archive="$UPDATE_ROOT/Downloads/ChatGPT-$latest_version.zip"
    if [[ ! -f "$archive" ]]; then
        print -u2 -r -- "Downloading ChatGPT $latest_short…"
        /usr/bin/curl --fail --show-error --location --retry 3 --retry-all-errors --retry-delay 2 \
            --continue-at - --output "$partial" "$latest_url" || \
            die "downloading ChatGPT $latest_short failed; the partial download was kept for retry"
        /bin/mv "$partial" "$archive" || die "finishing the ChatGPT download failed"
    fi

    staging="$UPDATE_ROOT/Staging/$latest_version.$$"
    [[ ! -e "$staging" ]] || die "the update staging path already exists: $staging"
    /bin/mkdir "$staging" || die "creating the update staging directory failed"
    if ! /usr/bin/ditto -x -k "$archive" "$staging"; then
        /bin/rm -rf "$staging"
        die "unpacking ChatGPT $latest_short failed"
    fi
    local -a apps
    apps=("$staging"/*.app(N/))
    if (( ${#apps} != 1 )); then
        /bin/rm -rf "$staging"
        die "the ChatGPT update contained ${#apps} top-level app bundles instead of one"
    fi
    extracted="${apps[1]}"
    if ! validate_vendor_app "$extracted" "$latest_version"; then
        /bin/rm -rf "$staging"
        die "the downloaded ChatGPT app failed its bundle ID, version, Team ID, or strict signature check"
    fi

    local prepared_root="$UPDATE_ROOT/Prepared/$latest_version"
    if [[ -e "$prepared_root" ]]; then
        local rejected="$UPDATE_ROOT/Rejected/$latest_version.$(/bin/date '+%Y%m%d-%H%M%S')"
        /bin/mkdir -p "${rejected:h}"
        /bin/mv "$prepared_root" "$rejected" || die "moving an invalid prepared update aside failed"
    fi
    /bin/mkdir "$prepared_root" || die "creating the prepared-update directory failed"
    /bin/mv "$extracted" "$prepared" || die "staging the verified ChatGPT app failed"
    metadata="$prepared_root/update.plist"
    /usr/bin/plutil -create xml1 "$metadata"
    /usr/bin/plutil -insert Build -string "$latest_version" "$metadata"
    /usr/bin/plutil -insert Version -string "$latest_short" "$metadata"
    /usr/bin/plutil -insert URL -string "$latest_url" "$metadata"
    /bin/rm -rf "$staging"
    release_update_lock
    trap - EXIT INT TERM
    print -r -- "ready\t$latest_version\t$latest_short"
}

verify_managed_instance() {
    local dir="$1" expected_version="$2" app info
    app="$(app_path_for "$dir")"
    info="$app/Contents/Info.plist"
    [[ -x "$app/Contents/MacOS/ChatGPT" && -f "$info" ]] || return 1
    [[ "$(instance_source_build "$app")" == "$expected_version" ]] || return 1
    [[ "$(/usr/bin/plutil -extract LSEnvironment.CODEX_SPARKLE_ENABLED raw "$info" 2>/dev/null)" == "false" ]] || return 1
    "$app/Contents/MacOS/ChatGPT" --doppel-verify >/dev/null 2>&1 || return 1
    return 0
}

# Which installed instances a reconcile has to rebuild, and how many there are
# in total.
#
# Stricter than instance_build_drift on purpose: that one decides whether to
# raise a prompt, this one decides what to close. The result is kept rather than
# recomputed because verification runs each instance's own binary, and because
# quitting an instance already built from this primary would close a window for
# nothing.
typeset -ga RECONCILE_STALE_DIRS=()
typeset -g RECONCILE_INSTANCE_COUNT=0
collect_reconcile_targets() {
    local expected="$1" dir app recorded
    RECONCILE_STALE_DIRS=()
    RECONCILE_INSTANCE_COUNT=0
    for dir in "$INSTANCES_ROOT"/*(N/); do
        is_instance_dir "$dir" || continue
        app="$(app_path_for "$dir")"
        [[ -d "$app" ]] || continue
        RECONCILE_INSTANCE_COUNT=$(( RECONCILE_INSTANCE_COUNT + 1 ))
        # Forward only. An instance built from a newer build than the installed
        # primary fails verification too, but rebuilding it would be a
        # downgrade: an Electron profile a later version has already migrated,
        # handed back to an earlier one. `doppel rebuild <name>` still does it
        # for someone who means to.
        recorded="$(instance_source_build "$app")"
        if valid_build_number "$recorded" && (( recorded > expected )); then
            continue
        fi
        verify_managed_instance "$dir" "$expected" || RECONCILE_STALE_DIRS+=("$dir")
    done
}

is_reconcile_target() {
    local candidate
    for candidate in $RECONCILE_STALE_DIRS; do
        if [[ "$candidate" == "$1" ]]; then return 0; fi
    done
    return 1
}

wait_for_instance() {
    local app="$1" waited=0
    while (( waited < 30 )); do
        /usr/bin/pgrep -f "${app}/Contents/MacOS/" >/dev/null 2>&1 && return 0
        /bin/sleep 1
        waited=$(( waited + 1 ))
    done
    return 1
}

wait_for_managed_instance() {
    local app="$1" waited=0
    # The small Doppel launcher immediately execs ChatGPT.real. Waiting for any
    # process under Contents/MacOS can catch that launcher in the hand-off gap
    # and report success just before the real app appears (or fails). Require
    # the preserved vendor executable instead.
    while (( waited < 30 )); do
        /usr/bin/pgrep -f "${app}/Contents/MacOS/ChatGPT.real" >/dev/null 2>&1 && return 0
        /bin/sleep 1
        waited=$(( waited + 1 ))
    done
    return 1
}

wait_for_locked_clone_adoption() {
    local app="$1" waited=0 observed_launcher=0
    while true; do
        /usr/bin/pgrep -f "${app}/Contents/MacOS/ChatGPT.real" >/dev/null 2>&1 && return 0
        if /usr/bin/pgrep -f "${app}/Contents/MacOS/ChatGPT" >/dev/null 2>&1 || \
           /usr/bin/pgrep -f "${app}/Contents/Resources/Doppel/doppel-engine.zsh launch" >/dev/null 2>&1; then
            observed_launcher=1
        elif (( observed_launcher )); then
            # The authorized launcher ended without adopting the profile. The
            # lock may now be released because no rebuilding/launch process is
            # still capable of starting ChatGPT.real behind the coordinator.
            return 1
        elif (( waited >= 10 )); then
            return 1
        fi
        /bin/sleep 1
        waited=$(( waited + 1 ))
    done
}

write_clone_launch_authorization() {
    local dir="$1" slug="${dir:t}" bundle_id token staged target
    bundle_id="$(config_value "$dir" DOPPEL_BUNDLE_ID)"
    token="$(/usr/bin/openssl rand -hex 32 2>/dev/null)" || \
        die "could not generate a private clone-launch authorization"
    [[ ${#token} -eq 64 && "$token" != *[^a-f0-9]* ]] || \
        die "the clone-launch authorization generator returned invalid data"
    /bin/mkdir -p "$CLONE_LAUNCH_ROOT" || \
        die "could not create the clone-launch authorization directory"
    /bin/chmod 700 "$CLONE_LAUNCH_ROOT" || \
        die "could not secure the clone-launch authorization directory"
    target="$CLONE_LAUNCH_ROOT/$slug"
    staged="$(/usr/bin/mktemp "$target.XXXXXXXX")" || \
        die "could not stage the clone-launch authorization"
    if ! printf '%s\t%s\n' "$token" "$bundle_id" > "$staged" || \
       ! /bin/chmod 600 "$staged" || ! /bin/mv "$staged" "$target"; then
        /bin/rm -f "$staged"
        die "could not save the clone-launch authorization"
    fi
    print -r -- "$token"
}

clear_clone_launch_authorization() {
    /bin/rm -f "$CLONE_LAUNCH_ROOT/${1:t}" 2>/dev/null || true
}

# Start the signed fallback only through a one-shot authorization created while
# the global engine lock is held. The embedded engine consumes it before
# ChatGPT.real starts, and this worker keeps the lock until that process is
# visible. Consequently a Finder launch and `browser assign` cannot cross in
# the read-slot-to-profile-adoption gap.
launch_clone_instance() {
    local dir="$1"
    shift
    local app name token marker
    name="$(config_value "$dir" DOPPEL_DISPLAY_NAME)"
    app="$(app_path_for "$dir")"
    if clone_instance_is_running "$dir"; then
        /usr/bin/open "$app" >/dev/null 2>&1 || true
        print -r -- "already running with Doppel engine: $name"
        return 0
    fi
    any_chatgpt_process_uses_profile "$dir" && \
        die "'$name''s Electron profile is already open through another ChatGPT app. Quit that window before launching its Doppel engine."
    [[ -d "$app" ]] || die "instance app not installed at $app; run: doppel rebuild '$name'"
    token="$(write_clone_launch_authorization "$dir")"
    marker="--doppel-authorized-clone=${dir:t}:$token"
    if ! /usr/bin/open -na "$app" --args "$marker" "$@" >/dev/null; then
        clear_clone_launch_authorization "$dir"
        die "the Doppel engine could not be launched: $app"
    fi
    if ! wait_for_locked_clone_adoption "$app"; then
        clear_clone_launch_authorization "$dir"
        die "the Doppel engine opened but did not finish adopting '$name''s profile"
    fi
    clear_clone_launch_authorization "$dir"
}

rebuild_instance_for_update() {
    local dir="$1" expected_version="$2" app
    app="$(app_path_for "$dir")"
    # Assets were compiled and installed for every instance before any app was
    # closed. Running the per-instance engines directly avoids compiling again
    # and avoids redundant Dock/Finder cache restarts during one update.
    /bin/zsh "$dir/doppel-engine.zsh" install "$app" >/dev/null 2>&1 && \
        verify_managed_instance "$dir" "$expected_version"
}

cmd_update_apply() {
    local version="${1:-}"
    [[ $# -le 1 ]] || die "usage: doppel update apply [build]"
    # A profile opened through the official engine is outside the managed-clone
    # quit/reopen manifest. Refuse before fetching, locking, compiling, or
    # touching any app so an update can never silently close it or reopen it
    # against the wrong profile root.
    local assigned_slug assigned_dir assigned_name
    assigned_slug="$(iab_slot_slug)"
    if [[ -n "$assigned_slug" && -n "$(vendor_main_pids)" ]]; then
        assigned_dir="$INSTANCES_ROOT/$assigned_slug"
        assigned_name="$(config_value "$assigned_dir" DOPPEL_DISPLAY_NAME)"
        die "the built-in browser is assigned to '$assigned_name' and an official ChatGPT window is open. Quit that window before installing the update; no apps were changed."
    fi
    local from_feed=0
    if [[ -z "$version" ]]; then
        local latest latest_short latest_url
        latest="$(fetch_latest_update)"
        IFS=$'\t' read -r version latest_short latest_url <<< "$latest"
        from_feed=1
    fi
    valid_build_number "$version" || die "the requested update build is invalid"
    local prepared prepared_root target_short current stamp backup restart_manifest
    local reconcile_only=0 total_instances=0 stale_instances=0
    validate_vendor_app "$PRIMARY_APP" || die "the installed primary ChatGPT app is not valid vendor-signed code"
    current="$(primary_version)"
    # Without a build to apply, the request is "make everything match", and a
    # feed that has fallen behind the installed primary is no reason to refuse
    # it. Naming an older build explicitly still is.
    if (( from_feed && version < current )); then
        version="$current"
    fi
    prepared="$(prepared_update_app "$version")"
    prepared_root="${prepared:h}"
    if (( version == current )); then
        # ChatGPT's own updater can install a build between Doppel staging it
        # and the user accepting the restart, and it only ever moves the
        # primary. Reconciling rebuilds the managed instances from the app that
        # is already installed: nothing is downloaded, nothing is swapped, and
        # the primary keeps running.
        #
        # That the target is the primary's own build is not on its own a reason
        # instances can only move forward — a primary restored to an older build
        # would make this a downgrade. What keeps it forward-only is
        # collect_reconcile_targets skipping any instance already built from a
        # newer build than the primary.
        reconcile_only=1
    else
        (( version > current )) || die "ChatGPT $version is older than the installed build $current"
        validate_vendor_app "$prepared" "$version" || die "ChatGPT $version has not been downloaded and verified; run 'doppel update prepare' first"
    fi
    target_short="$(update_metadata_value "$version" Version)"
    if [[ -z "$target_short" ]] && (( reconcile_only )); then
        target_short="$(primary_short_version)"
    fi
    [[ -n "$target_short" ]] || target_short="$version"
    if (( reconcile_only )); then
        collect_reconcile_targets "$current"
        total_instances=$RECONCILE_INSTANCE_COUNT
        (( total_instances > 0 )) || die "there are no installed managed instances to update"
        stale_instances=${#RECONCILE_STALE_DIRS}
        if (( stale_instances == 0 )); then
            printf 'current\t%s\t%s\t%s\t0\n' "$current" "$version" "$total_instances"
            return 0
        fi
    fi

    acquire_update_lock
    trap 'release_update_lock' EXIT INT TERM
    compile_helpers
    local dir name app bundle_id primary_was_running=0
    local -a dirs names apps running_apps failures verified_apps
    for dir in "$INSTANCES_ROOT"/*(N/); do
        is_instance_dir "$dir" || continue
        app="$(app_path_for "$dir")"
        [[ -d "$app" ]] || continue
        # An update moves every instance because the app they were all built
        # from changed. A reconcile has business only with the ones left behind:
        # an instance already built from this primary would be closed, rebuilt
        # and reopened to arrive exactly where it started.
        if (( reconcile_only )) && ! is_reconcile_target "$dir"; then
            continue
        fi
        dirs+=("$dir")
        names+=("$(config_value "$dir" DOPPEL_DISPLAY_NAME)")
        apps+=("$app")
        install_engine_assets "$dir"
        if clone_instance_is_running "$dir"; then
            running_apps+=("$app")
        fi
    done
    (( ${#dirs} > 0 )) || die "there are no installed managed instances to update"
    # A reconcile leaves /Applications/ChatGPT.app alone, so there is no reason
    # to close the official window the user may be working in.
    if (( reconcile_only == 0 )) && [[ -n "$(vendor_main_pids)" ]]; then
        primary_was_running=1
    fi

    restart_manifest="$UPDATE_ROOT/restart-after-update"
    : > "$restart_manifest"
    (( primary_was_running )) && print -r -- "$PRIMARY_APP" >> "$restart_manifest"
    for app in $running_apps; do print -r -- "$app" >> "$restart_manifest"; done
    UPDATE_ABORT_MANIFEST="$restart_manifest"
    trap 'abort_update_cleanup' EXIT INT TERM

    # All destructive work starts only after the download, vendor signature,
    # instance inventory, helper compilation, and restart manifest are ready.
    local index
    if (( primary_was_running )); then
        quit_instance "$PRIMARY_APP" "$PRIMARY_BUNDLE_ID" "ChatGPT"
    fi
    for (( index = 1; index <= ${#dirs}; index++ )); do
        app="${apps[$index]}"
        name="${names[$index]}"
        bundle_id="$(config_value "${dirs[$index]}" DOPPEL_BUNDLE_ID)"
        quit_instance "$app" "$bundle_id" "$name"
    done

    if (( reconcile_only == 0 )); then
        stamp="$(/bin/date '+%Y%m%d-%H%M%S')"
        # Keep the untouched vendor-signed rollback whole. macOS can deny edits
        # inside it through App Management, while placing the complete bundle in
        # a dot-directory keeps it out of app discovery without changing its
        # seal.
        /bin/mkdir -p "$UPDATE_ROOT/.Backups"
        backup="$UPDATE_ROOT/.Backups/ChatGPT.$current.$stamp.app"
        [[ ! -e "$backup" ]] || die "the primary rollback path already exists: $backup"
        "$LSREGISTER" -u "$PRIMARY_APP" >/dev/null 2>&1 || true
        /bin/mv "$PRIMARY_APP" "$backup" || die "moving the current primary ChatGPT app into rollback storage failed"
        if ! /bin/mv "$prepared" "$PRIMARY_APP"; then
            /bin/mv "$backup" "$PRIMARY_APP" || true
            die "installing ChatGPT $target_short failed; the previous primary was restored"
        fi
        if ! validate_vendor_app "$PRIMARY_APP" "$version"; then
            local rejected="$UPDATE_ROOT/Rejected/ChatGPT.$version.$stamp.app"
            /bin/mkdir -p "${rejected:h}"
            /bin/mv "$PRIMARY_APP" "$rejected" || true
            /bin/mv "$backup" "$PRIMARY_APP" || true
            die "the installed primary failed post-install verification; the previous primary was restored"
        fi
        "$LSREGISTER" -f "$PRIMARY_APP" >/dev/null 2>&1 || true
    fi

    # Instance bundles have separate staging, backup, pin, and lock roots, so
    # their expensive clone/sign/verify work is independent. Rebuild all of
    # them concurrently, keeping process IDs in the same order as the instance
    # arrays so results are still reported deterministically.
    local -a rebuild_pids
    for (( index = 1; index <= ${#dirs}; index++ )); do
        rebuild_instance_for_update "${dirs[$index]}" "$version" &
        rebuild_pids+=("$!")
    done
    for (( index = 1; index <= ${#dirs}; index++ )); do
        name="${names[$index]}"
        if wait "${rebuild_pids[$index]}"; then
            verified_apps+=("${apps[$index]}")
        else
            failures+=("$name did not rebuild or verify")
        fi
    done

    local reopened=0 was_running verified reopen_dir
    for was_running in $running_apps; do
        verified=0
        for app in $verified_apps; do [[ "$app" == "$was_running" ]] && verified=1; done
        if (( verified )); then
            reopen_dir="$(instance_dir_for_app_path "$was_running" 2>/dev/null || true)"
            if [[ -n "$reopen_dir" ]] && launch_clone_instance "$reopen_dir"; then
                reopened=$(( reopened + 1 ))
            else
                failures+=("${was_running:t:r} was updated but did not reopen")
            fi
        fi
    done

    if (( primary_was_running )); then
        if ! /usr/bin/open -na "$PRIMARY_APP" >/dev/null 2>&1 || ! wait_for_instance "$PRIMARY_APP"; then
            failures+=("the primary ChatGPT app was updated but did not reopen")
        fi
    fi

    local outcome="updated" summary="ChatGPT updated to $target_short"
    if (( reconcile_only )); then
        outcome="reconciled"
        summary="ChatGPT $target_short was already installed"
    fi
    if (( ${#failures} > 0 )); then
        release_update_lock
        trap - EXIT INT TERM
        die "$summary, but Doppel could not finish every instance: ${(j:; :)failures}. Restart information remains at $restart_manifest"
    fi
    /bin/rm -f "$restart_manifest"
    UPDATE_ABORT_MANIFEST=""
    if (( reconcile_only )); then
        # A build the primary already carries can never be installed from
        # staging, so whatever a superseded prepare left there is dead weight.
        # Named piece by piece rather than removed wholesale: the same narrow
        # reach as the install path below, which only ever names what it put
        # there.
        /bin/rm -rf "$prepared_root/ChatGPT.app"
        /bin/rm -f "$prepared_root/update.plist"
        /bin/rmdir "$prepared_root" 2>/dev/null || true
    else
        # The installed app was moved out of $prepared_root; update.plist stays
        # behind and would make a bare rmdir fail silently every time.
        /bin/rm -f "$prepared_root/update.plist"
        /bin/rmdir "$prepared_root" 2>/dev/null || true
    fi
    release_update_lock
    trap - EXIT INT TERM
    printf '%s\t%s\t%s\t%s\t%s\n' "$outcome" "$current" "$version" "${#verified_apps}" "$reopened"
}

cmd_update_verify() {
    [[ $# -eq 0 ]] || die "usage: doppel update verify"
    validate_vendor_app "$PRIMARY_APP" || die "the primary ChatGPT app failed vendor-signature verification"
    local version dir count=0 failed=0 name
    version="$(primary_version)"
    for dir in "$INSTANCES_ROOT"/*(N/); do
        is_instance_dir "$dir" || continue
        [[ -d "$(app_path_for "$dir")" ]] || continue
        name="$(config_value "$dir" DOPPEL_DISPLAY_NAME)"
        if verify_managed_instance "$dir" "$version"; then
            print -r -- "verified: $name ($version)"
            count=$(( count + 1 ))
        else
            print -u2 -r -- "not verified: $name"
            failed=$(( failed + 1 ))
        fi
    done
    (( failed == 0 )) || die "$failed managed instance(s) failed verification"
    print -r -- "verified primary and $count managed instance(s) at build $version"
}

cmd_update() {
    local action="${1:-check}"
    (( $# > 0 )) && shift
    case "$action" in
        check) cmd_update_check "$@" ;;
        prepare) cmd_update_prepare "$@" ;;
        apply) with_iab_operation_lock cmd_update_apply "$@" ;;
        verify) cmd_update_verify "$@" ;;
        *) die "usage: doppel update {check|prepare|apply|verify} ..." ;;
    esac
}

# MARK: - Per-instance permission health

permission_label() {
    case "$1" in
        accessibility) print -r -- "Accessibility" ;;
        screen-recording) print -r -- "Screen & System Audio Recording" ;;
        microphone) print -r -- "Microphone" ;;
        camera) print -r -- "Camera" ;;
        notifications) print -r -- "Notifications" ;;
        permission-check) print -r -- "Permission checker" ;;
        *) print -r -- "$1" ;;
    esac
}

permission_rows_for_dir() {
    local dir="$1" app name slug engine output permission permission_state
    app="$(app_path_for "$dir")"
    [[ -d "$app" ]] || return 0
    name="$(config_value "$dir" DOPPEL_DISPLAY_NAME)"
    slug="${dir:t}"
    engine="$(/usr/bin/plutil -extract DoppelEngineVersion raw "$app/Contents/Info.plist" 2>/dev/null || true)"
    # Engines before 22 signed the launcher without the vendor's device
    # entitlements, so its microphone and camera requests were silently denied
    # by tccd: no prompt, no System Settings row, status forever not-requested.
    # Reporting such a bundle as outdated is what raises the menu-bar warning
    # and points the user at the rebuild that actually fixes it.
    if [[ "$engine" != <22-> || ! -x "$app/Contents/MacOS/ChatGPT" ]]; then
        printf '%s\t%s\t%s\t%s\n' "$slug" "$name" "permission-check" "outdated"
        return 0
    fi

    # Launch through Launch Services rather than executing the bundle binary as
    # Doppel's child. macOS privacy attribution follows the responsible app;
    # the direct child check could therefore report Doppel's grants instead of
    # this managed app's. `open --stdout` preserves the checker's stable output.
    local probe_root="$DOPPEL_HOME/permission-checks" status_file error_file
    /bin/mkdir -p "$probe_root" || return 1
    /bin/chmod 700 "$probe_root"
    status_file="$(/usr/bin/mktemp "$probe_root/status.XXXXXXXX")" || return 1
    error_file="$(/usr/bin/mktemp "$probe_root/error.XXXXXXXX")" || {
        /bin/rm -f "$status_file"
        return 1
    }
    if ! /usr/bin/open -n -W "$app" --stdout "$status_file" --stderr "$error_file" \
        --args --doppel-permission-status >/dev/null 2>&1; then
        /bin/rm -f "$status_file" "$error_file"
        printf '%s\t%s\t%s\t%s\n' "$slug" "$name" "permission-check" "error"
        return 0
    fi
    output="$(<"$status_file")"
    /bin/rm -f "$status_file" "$error_file"
    [[ -n "$output" ]] || {
        printf '%s\t%s\t%s\t%s\n' "$slug" "$name" "permission-check" "error"
        return 0
    }
    while IFS=$'\t' read -r permission permission_state; do
        [[ -n "$permission" && -n "$permission_state" ]] || continue
        # The CoreGraphics and Accessibility APIs expose only a boolean. A
        # false value is not proof that the setting is absent (and can lag the
        # visible System Settings row), so do not label it "missing".
        [[ "$permission_state" != "missing" ]] || permission_state="unconfirmed"
        printf '%s\t%s\t%s\t%s\n' "$slug" "$name" "$permission" "$permission_state"
    done <<< "$output"
}

cmd_permissions_check() {
    local porcelain=0 target="" arg dir rows=""
    for arg in "$@"; do
        case "$arg" in
            --porcelain) porcelain=1 ;;
            *) [[ -z "$target" ]] || die "usage: doppel permissions check [--porcelain] [<name>]"
               target="$arg" ;;
        esac
    done
    if [[ -n "$target" ]]; then
        dir="$(instance_dir_for "$target")"
        rows="$(permission_rows_for_dir "$dir")"
    else
        for dir in "$INSTANCES_ROOT"/*(N/); do
            is_instance_dir "$dir" || continue
            rows+="$(permission_rows_for_dir "$dir")"$'\n'
        done
    fi
    if (( porcelain )); then
        print -rn -- "$rows"
        return 0
    fi
    local slug name permission permission_state found=0
    while IFS=$'\t' read -r slug name permission permission_state; do
        [[ -n "$permission" ]] || continue
        [[ "$permission_state" != "granted" ]] || continue
        found=1
        print -r -- "$name: $(permission_label "$permission") — $permission_state"
    done <<< "$rows"
    (( found )) || print -r -- "All installed instances have the checked permissions."
}

cmd_permissions_request() {
    (( $# >= 1 && $# <= 2 )) || die "usage: doppel permissions request <name> [permission]"
    local name="$1" permission="${2:-}" dir app engine
    if [[ -n "$permission" ]]; then
        case "$permission" in
            accessibility|screen-recording|microphone|camera|notifications) ;;
            *) die "unknown permission '$permission'; expected accessibility, screen-recording, microphone, camera, or notifications" ;;
        esac
    fi
    dir="$(instance_dir_for "$name")"
    app="$(app_path_for "$dir")"
    [[ -d "$app" ]] || die "'$name' is not installed"
    engine="$(/usr/bin/plutil -extract DoppelEngineVersion raw "$app/Contents/Info.plist" 2>/dev/null || true)"
    if [[ -z "$permission" ]]; then
        # The bulk request includes microphone and camera whenever they are
        # not-requested, and a pre-22 launcher has no device entitlements, so
        # tccd would skip them silently: no prompt, no Settings row, exit 0.
        [[ "$engine" == <22-> ]] || die "'$name' must be rebuilt before Doppel can request permissions"
        /usr/bin/open -n -W "$app" --args --doppel-request-permissions || \
            die "'$name' could not start its native permission requests"
        return 0
    fi

    [[ "$engine" == <18-> ]] || \
        die "'$name' must be rebuilt before Doppel can request one permission at a time"
    # A pre-22 launcher carries no device entitlements, so tccd denies its
    # microphone and camera requests without a prompt or a Settings row.
    # Failing here turns that silent no-op into an actionable message.
    if [[ "$permission" == (microphone|camera) && "$engine" != <22-> ]]; then
        die "'$name' must be rebuilt before Doppel can request $permission access"
    fi

    # `open -W` does not reliably forward the launched application's exit
    # status. Capture and validate the helper's one-row result instead, using a
    # private directory so another local process cannot replace the files.
    local request_root="$DOPPEL_HOME/permission-checks" status_file error_file output result_permission result_status
    /bin/mkdir -p "$request_root" || die "could not create the permission request directory"
    /bin/chmod 700 "$request_root"
    status_file="$(/usr/bin/mktemp "$request_root/request.XXXXXXXX")" || \
        die "could not create the permission request result file"
    error_file="$(/usr/bin/mktemp "$request_root/error.XXXXXXXX")" || {
        /bin/rm -f "$status_file"
        die "could not create the permission request error file"
    }
    if ! /usr/bin/open -n -W "$app" --stdout "$status_file" --stderr "$error_file" \
        --args --doppel-request-permission "$permission" >/dev/null 2>&1; then
        output="$(<"$error_file")"
        /bin/rm -f "$status_file" "$error_file"
        [[ -n "$output" ]] || output="the managed app did not launch"
        die "'$name' could not request $permission: $output"
    fi
    output="$(<"$status_file")"
    /bin/rm -f "$status_file" "$error_file"
    IFS=$'\t' read -r result_permission result_status <<< "$output"
    [[ "$result_permission" == "$permission" ]] || \
        die "'$name' returned no valid result after requesting $permission"
    case "$result_status" in
        granted|not-requested|denied|restricted|missing|unknown) ;;
        *) die "'$name' returned an invalid status after requesting $permission" ;;
    esac
    printf '%s\t%s\n' "$result_permission" "$result_status"
}

cmd_permissions() {
    local action="${1:-}"
    [[ -n "$action" ]] && shift
    case "$action" in
        check) cmd_permissions_check "$@" ;;
        request) cmd_permissions_request "$@" ;;
        *) die "usage: doppel permissions {check|request} ..." ;;
    esac
}

# MARK: - Chromium extension-host ownership
#
# The in-app browser cannot work in a locally re-signed clone: the vendor gates
# its browser socket on the connecting process, its parent AND its grandparent
# each carrying OpenAI's Team ID, and the grandparent is the instance's own
# locally signed executable. A clone can never satisfy that, so the ChatGPT
# browser extension is that engine's route to a real browser. A profile assigned
# Doppel's vendor engine slot is the exception: its untouched OpenAI-signed
# runtime is eligible for the built-in browser.
#
# That route arrives through one global native-messaging manifest per Chromium
# browser, and every ChatGPT app rewrites it to its own extension host during
# startup. Ownership therefore goes to whichever app launched last, silently,
# and every other instance is left with no browser of any kind. Doppel cannot
# stop the vendor writing that file, but it can say who holds it and hand it
# back to a chosen instance deliberately.
readonly BROWSER_HOST_MANIFEST_NAME="com.openai.codexextension.json"
# Overridable so QA can exercise claiming without touching a real browser
# profile; every path below is relative to it.
readonly BROWSER_SUPPORT_ROOT="${DOPPEL_BROWSER_SUPPORT_ROOT:-$HOME/Library/Application Support}"
typeset -gA BROWSER_HOST_MANIFEST_DIRS=(
    Chrome   "$BROWSER_SUPPORT_ROOT/Google/Chrome/NativeMessagingHosts"
    Edge     "$BROWSER_SUPPORT_ROOT/Microsoft Edge/NativeMessagingHosts"
    Chromium "$BROWSER_SUPPORT_ROOT/Chromium/NativeMessagingHosts"
    Brave    "$BROWSER_SUPPORT_ROOT/BraveSoftware/Brave-Browser/NativeMessagingHosts"
)

# The host binary ships per architecture, so the slice is globbed rather than
# assumed: an Intel Mac stores it under macos/x86_64.
browser_host_binary_for_home() {
    local home="$1" candidate
    for candidate in \
        "$home/plugins/cache/openai-bundled/chrome/latest/extension-host/macos"/*/"ChatGPT for Chrome"(N); do
        print -r -- "$candidate"
        return 0
    done
    return 1
}

browser_host_home_from_binary() {
    local path="$1"
    [[ "$path" == */plugins/cache/openai-bundled/chrome/* ]] || return 1
    print -r -- "${path%%/plugins/cache/openai-bundled/chrome/*}"
}

# Several instances may legitimately share one CODEX_HOME, and an instance may
# share it with the primary app, so every match is reported rather than the
# first one found.
#
# With annotate=1 the result is prose for a human reading `status`. Without it
# the result is data: bare display names, comma-separated, so a caller can match
# one against an instance name. The note about sharing the primary's runtime
# would otherwise end up inside the name and match nothing.
browser_host_owner_label() {
    local home="$1" annotate="${2:-0}" dir matched=""
    for dir in "$INSTANCES_ROOT"/*(N/); do
        is_instance_dir "$dir" || continue
        [[ "$(config_value "$dir" DOPPEL_CODEX_HOME)" == "$home" ]] || continue
        matched="${matched:+$matched, }$(config_value "$dir" DOPPEL_DISPLAY_NAME)"
    done
    if [[ -n "$matched" ]]; then
        (( annotate )) && [[ "$home" == "$HOME/.codex" ]] && \
            matched="$matched (shared with the primary app)"
        print -r -- "$matched"
        return 0
    fi
    [[ "$home" == "$HOME/.codex" ]] && { print -r -- "ChatGPT (primary app)"; return 0 }
    print -r -- "unrecognised runtime at $home"
}

browser_host_manifest_binary() {
    local manifest="$1"
    /usr/bin/python3 - "$manifest" <<'PYREAD' 2>/dev/null
import json, sys
try:
    with open(sys.argv[1]) as f:
        print(json.load(f).get("path", ""))
except Exception:
    pass
PYREAD
}

# Only the path is rewritten. The origins, host name and transport are the
# vendor's and are left exactly as found, so this claims an existing
# registration rather than manufacturing one.
browser_host_claim_manifest() {
    local manifest="$1" binary="$2"
    /usr/bin/python3 - "$manifest" "$binary" <<'PYCLAIM'
import json, os, sys, tempfile
manifest, binary = sys.argv[1], sys.argv[2]
with open(manifest) as f:
    data = json.load(f)
if data.get("path") == binary:
    raise SystemExit(2)
data["path"] = binary
directory = os.path.dirname(manifest)
handle, staged = tempfile.mkstemp(dir=directory, prefix=".doppel-host-")
try:
    with os.fdopen(handle, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    os.replace(staged, manifest)
except BaseException:
    os.unlink(staged)
    raise
PYCLAIM
}

# Each Chromium browser has its own registration, so two instances can hold two
# different browsers at the same time. Without --browser every registration goes
# to one instance, which is what a single-browser machine wants.
cmd_native_tools_claim_browser() {
    # Declared up front: a bare `local` on an already-local name prints it, and
    # the loop below would otherwise redeclare on every browser.
    local name="$1" only="${2:-}" dir home binary browser manifest label failed="" outcome
    local -i claimed=0 unchanged=0
    if [[ -n "$only" ]]; then
        # Sorted through an array: the join flag does not order the keys on its
        # own, so listing them inline printed them in hash order.
        local -a known
        known=(${(ko)BROWSER_HOST_MANIFEST_DIRS})
        [[ -n "${BROWSER_HOST_MANIFEST_DIRS[$only]:-}" ]] || \
            die "unknown browser: $only (known: ${(j:, :)known})"
    fi
    dir="$(instance_dir_for "$name")"
    home="$(config_value "$dir" DOPPEL_CODEX_HOME)"
    [[ -n "$home" ]] || die "that instance does not record a CODEX_HOME: $name"
    binary="$(browser_host_binary_for_home "$home")" || \
        die "that instance has no browser extension host yet; launch it once so ChatGPT installs one, then claim again"
    [[ -x "$binary" ]] || die "the instance's browser extension host is not executable: $binary"
    label="$(config_value "$dir" DOPPEL_DISPLAY_NAME)"

    # One unreadable registration must not decide how many of the others were
    # rewritten, so the loop records the failure and keeps going, in a fixed
    # order, and the command reports what actually moved before it fails.
    for browser in ${(ko)BROWSER_HOST_MANIFEST_DIRS}; do
        [[ -z "$only" || "$browser" == "$only" ]] || continue
        manifest="${BROWSER_HOST_MANIFEST_DIRS[$browser]}/$BROWSER_HOST_MANIFEST_NAME"
        [[ -f "$manifest" ]] || continue
        # `|| outcome=$?` rather than a bare call: this script runs under
        # errexit, which would abort the whole command on the first registration
        # that is already correct or cannot be read.
        outcome=0
        browser_host_claim_manifest "$manifest" "$binary" 2>/dev/null || outcome=$?
        if (( outcome == 0 )); then
            print -r -- "claimed $browser for $label"
            claimed+=1
        elif (( outcome == 2 )); then
            print -r -- "$browser already points at $label"
            unchanged+=1
        else
            failed="${failed:+$failed, }$browser"
        fi
    done

    (( claimed + unchanged > 0 )) || [[ -n "$failed" ]] || \
        die "no ChatGPT browser-extension registration was found${only:+ for $only}; install the ChatGPT extension in ${only:-a Chromium browser} first"
    if (( claimed )); then
        print -r -- "reconnect the extension (or reload the browser tab) for the change to take effect"
    fi
    if (( claimed + unchanged )); then
        print -r -- "the next managed app to launch will take this back; re-claim after launching another instance"
    fi
    [[ -z "$failed" ]] || \
        die "these registrations could not be rewritten and were left alone: $failed"
}

# MARK: - Native-tool health

native_tools_status() {
    local porcelain="${1:-0}" computer_state="idle" socket
    socket="$HOME/Library/Group Containers/$PRIMARY_TEAM_ID.com.openai.sky.CUAService/IPC/computeruse.sock"
    [[ -S "$socket" ]] && computer_state="ready"

    local chronicle_state="stopped" chronicle_host="" chronicle_app="" frame_age="-1"
    local status_file="${TMPDIR%/}/codex_chronicle/chronicle-started.pid" pid="" command=""
    if [[ -r "$status_file" ]]; then
        pid="$(<"$status_file")"
        if [[ "$pid" == <1-> ]]; then
            command="$(/bin/ps -p "$pid" -o command= 2>/dev/null || true)"
        fi
    fi
    if [[ "$command" == */Contents/Resources/codex_chronicle* ]]; then
        chronicle_state="running"
        chronicle_app="${command%%/Contents/Resources/codex_chronicle*}"
        chronicle_host="$(/usr/bin/plutil -extract CFBundleDisplayName raw \
            "$chronicle_app/Contents/Info.plist" 2>/dev/null || true)"
        [[ -n "$chronicle_host" ]] || chronicle_host="${chronicle_app:t:r}"
    fi

    local recording_root="${TMPDIR%/}/chronicle/screen_recording" newest_frame="" now modified
    local -a frames
    frames=("$recording_root"/*-latest.jpg(N.om))
    if (( ${#frames} > 0 )); then
        newest_frame="${frames[1]}"
        modified="$(/usr/bin/stat -f '%m' "$newest_frame" 2>/dev/null || true)"
        now="$(/bin/date '+%s')"
        [[ "$modified" == <1-> && "$now" == <1-> ]] && frame_age=$(( now - modified ))
    fi

    local rollback_count
    rollback_count="$(discoverable_rollback_count)"

    local iab_slug iab_dir="" iab_name="" iab_state="stopped" iab_signature="invalid"
    local runtime_kind runtime_slug runtime_name runtime_pid
    IFS=$'\t' read -r runtime_kind runtime_slug runtime_name runtime_pid \
        <<< "$(vendor_runtime_snapshot)"
    iab_slug="$(iab_slot_slug)"
    if [[ -n "$iab_slug" ]]; then
        iab_dir="$INSTANCES_ROOT/$iab_slug"
        iab_name="$(config_value "$iab_dir" DOPPEL_DISPLAY_NAME)"
        if [[ "$runtime_kind" != "none" && \
              ( "$runtime_kind" != "managed" || "$runtime_slug" != "$iab_slug" ) ]]; then
            iab_state="conflict"
        elif vendor_instance_is_running "$iab_dir"; then
            iab_state="running"
        elif [[ "$runtime_kind" == "managed" && "$runtime_slug" == "$iab_slug" ]]; then
            iab_state="untracked"
        fi
        validate_vendor_app "$PRIMARY_APP" && iab_signature="valid"
    fi

    # Declared before the loop, not inside it: a bare `local` on a name that is
    # already local displays its current value, which printed the internals of
    # this scan into the status output.
    local browser owner_home manifest binary owner owner_prose
    local -a browser_rows browser_lines
    for browser in ${(ko)BROWSER_HOST_MANIFEST_DIRS}; do
        manifest="${BROWSER_HOST_MANIFEST_DIRS[$browser]}/$BROWSER_HOST_MANIFEST_NAME"
        [[ -f "$manifest" ]] || continue
        binary="$(browser_host_manifest_binary "$manifest")"
        owner_home=""
        if [[ -z "$binary" ]]; then
            owner="unreadable registration"
            owner_prose="$owner"
        elif owner_home="$(browser_host_home_from_binary "$binary")"; then
            owner="$(browser_host_owner_label "$owner_home")"
            owner_prose="$(browser_host_owner_label "$owner_home" 1)"
            [[ -x "$binary" ]] || owner_prose="$owner_prose (host binary missing)"
        else
            owner="unrecognised host at $binary"
            owner_prose="$owner"
            owner_home=""
        fi
        browser_rows+=("$browser	$owner	$owner_home	$manifest")
        browser_lines+=("Browser extension host: $browser belongs to $owner_prose")
    done

    if (( porcelain )); then
        printf 'computer-use\t%s\n' "$computer_state"
        printf 'chronicle\t%s\t%s\t%s\t%s\n' \
            "$chronicle_state" "$chronicle_host" "$chronicle_app" "$frame_age"
        printf 'rollbacks\t%s\n' "$rollback_count"
        if [[ -n "$iab_slug" ]]; then
            printf 'in-app-browser\tassigned\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
                "$iab_slug" "$iab_name" "$iab_state" "$iab_signature" \
                "$runtime_kind" "$runtime_slug" "$runtime_name"
        else
            printf 'in-app-browser\tunassigned\t%s\t%s\t%s\n' \
                "$runtime_kind" "$runtime_slug" "$runtime_name"
        fi
        local row
        for row in "${browser_rows[@]}"; do
            printf 'browser-host\t%s\n' "$row"
        done
        # The trailing field says whether this instance has a browser extension
        # host of its own yet, which is what decides whether it can be handed
        # the registration. An instance that has never run has none.
        local dir name app claimable
        for dir in "$INSTANCES_ROOT"/*(N/); do
            is_instance_dir "$dir" || continue
            name="$(config_value "$dir" DOPPEL_DISPLAY_NAME)"
            app="$(app_path_for "$dir")"
            claimable=no
            browser_host_binary_for_home "$(config_value "$dir" DOPPEL_CODEX_HOME)" \
                >/dev/null 2>&1 && claimable=yes
            printf 'instance\t%s\t%s\t%s\t%s\t%s\n' "${dir:t}" "$name" "$app" \
                "$(config_value "$dir" DOPPEL_BUNDLE_ID)" "$claimable"
        done
        return 0
    fi

    print -r -- "Computer Use: $computer_state"
    if [[ "$chronicle_state" == "running" ]]; then
        print -r -- "Chronicle: shared by $chronicle_host (latest frame ${frame_age}s ago)"
    else
        print -r -- "Chronicle: stopped"
    fi
    print -r -- "Discoverable rollback apps: $rollback_count"
    if [[ -n "$iab_slug" && "$iab_state" == "conflict" ]]; then
        print -r -- "In-app browser: assigned to $iab_name, but official ChatGPT is currently using $runtime_name"
    elif [[ -n "$iab_slug" && "$iab_state" == "untracked" ]]; then
        print -r -- "In-app browser: $iab_name (running outside Doppel; official engine signature $iab_signature)"
    elif [[ -n "$iab_slug" ]]; then
        print -r -- "In-app browser: $iab_name ($iab_state; official engine signature $iab_signature)"
    elif [[ "$runtime_kind" == "managed" ]]; then
        print -r -- "In-app browser: not assigned; official ChatGPT is currently using $runtime_name"
    elif [[ "$runtime_kind" != "none" ]]; then
        print -r -- "In-app browser: not assigned; another official ChatGPT process is running ($runtime_name)"
    else
        print -r -- "In-app browser: not assigned (locally signed engines use the browser extension)"
    fi
    if (( ${#browser_lines} == 0 )); then
        print -r -- "Browser extension host: no ChatGPT registration found in any Chromium browser"
    else
        print -rl -- "${browser_lines[@]}"
    fi
}

cmd_native_tools() {
    local action="${1:-status}"
    (( $# > 0 )) && shift
    case "$action" in
        status)
            local porcelain=0
            if [[ $# -eq 1 && "$1" == "--porcelain" ]]; then
                porcelain=1
            elif [[ $# -ne 0 ]]; then
                die "usage: doppel native-tools status [--porcelain]"
            fi
            native_tools_status "$porcelain"
            ;;
        repair)
            [[ $# -eq 0 ]] || die "usage: doppel native-tools repair"
            local repaired
            repaired="$(repair_rollback_discovery)"
            print -r -- "repaired $repaired stored rollback app(s); active instances were not changed"
            native_tools_status 0
            ;;
        claim-browser)
            local claim_only=""
            if [[ "${1:-}" == --browser ]]; then
                [[ -n "${2:-}" ]] || die "usage: doppel native-tools claim-browser [--browser <Chrome|Edge|Chromium|Brave>] <name>"
                claim_only="$2"; shift 2
            fi
            [[ $# -eq 1 && -n "$1" ]] || \
                die "usage: doppel native-tools claim-browser [--browser <Chrome|Edge|Chromium|Brave>] <name>"
            cmd_native_tools_claim_browser "$1" "$claim_only"
            ;;
        *) die "usage: doppel native-tools {status [--porcelain]|repair|claim-browser [--browser <name>] <name>}" ;;
    esac
}

# Rollback copies are whole app bundles, about 1.4GB each, and one is kept
# every time an instance is rebuilt — which a vendor update does on its own.
# Nothing used to remove them, so they simply accumulated.
cmd_prune() {
    # Declared once: `local x` on a name that is already local in the same
    # scope makes zsh print it, which turned a loop into pages of debug output.
    local keep="${DOPPEL_KEEP_BACKUPS:-1}"
    local state_root="$DOPPEL_HOME/state" before after instance_state staged index only=""
    local -a targets rollbacks

    # With a name, only that instance's copies are touched. Without one,
    # everything, which is what reclaims space left by older versions.
    if [[ -n "${1:-}" ]]; then
        local dir
        # Resolved in its own step: nesting this inside another substitution
        # let the "no such instance" message be followed by a second one.
        dir="$(instance_dir_for "$1")"
        only="$(config_value "$dir" DOPPEL_BUNDLE_ID)"
        [[ -n "$only" ]] || die "'$1' has no bundle identifier to prune"
    fi

    [[ -d "$state_root" ]] || { print -r -- "nothing to prune"; return 0 }
    if [[ -n "$only" ]]; then
        targets=("$state_root/$only"(N/))
    else
        targets=("$state_root"/*(N/))
    fi
    before="$(/usr/bin/du -sk "$state_root" 2>/dev/null | /usr/bin/awk '{print $1}')"
    for instance_state in $targets; do
        [[ "${instance_state:t}" != "Removed" ]] || continue
        rollbacks=("$instance_state/Backups"/*.rollback(N/om))
        for (( index = keep + 1; index <= ${#rollbacks}; index++ )); do
            /bin/rm -rf "${rollbacks[$index]}"
        done
        # Staging only ever holds a build in flight; anything left is debris
        # from one that failed.
        for staged in "$instance_state/Staging"/*(N/); do
            /bin/rm -rf "$staged"
        done
    done
    after="$(/usr/bin/du -sk "$state_root" 2>/dev/null | /usr/bin/awk '{print $1}')"
    printf 'pruned: %s -> %s (keeping %s rollback(s) per instance)\n' \
        "$(format_size "$before")" "$(format_size "$after")" "$keep"
}

format_size() {
    local kilobytes="${1:-0}"
    if (( kilobytes >= 1048576 )); then
        printf '%.1fGB' "$(( kilobytes / 1048576.0 ))"
    elif (( kilobytes >= 1024 )); then
        printf '%dMB' "$(( kilobytes / 1024 ))"
    else
        printf '%dKB' "$kilobytes"
    fi
}

# The pin an instance's launcher checks is keyed by the bundle's own path, so a
# bundle that moves or goes away leaves a record behind.
forget_pinned_requirement() {
    local app="$1" digest
    digest="$(print -rn -- "${app:A}" | /usr/bin/shasum -a 256 | /usr/bin/awk '{print $1}')"
    /bin/rm -f "$DOPPEL_HOME/pins/$digest" 2>/dev/null || true
}

# The hidden worker entrypoint is valid only while its parent supervisor owns
# the exact global lock. It runs one whitelisted function without recursively
# acquiring that same lock.
if [[ "${1:-}" == "__iab-worker" ]]; then
    [[ $# -ge 3 && "$2" == <1-> && "$PPID" == "$2" && \
       "$(cat "$IAB_OPERATION_LOCK/pid" 2>/dev/null || true)" == "$2" ]] || \
        die "invalid internal engine-operation worker"
    readonly IAB_WORKER_OPERATION="$3"
    shift 3
    case "$IAB_WORKER_OPERATION" in
        cmd_create|cmd_launch|cmd_route_launch|cmd_rebuild|cmd_edit|cmd_remove|cmd_browser_assign|cmd_browser_release|cmd_update_apply)
            "$IAB_WORKER_OPERATION" "$@"
            exit $?
            ;;
        *) die "invalid internal engine operation" ;;
    esac
fi

case "${1:-}" in
    __route-launch) [[ $# -ge 2 ]] || die "invalid internal routed launch"; shift; with_iab_operation_lock cmd_route_launch "$@" ;;
    create) shift; with_iab_operation_lock cmd_create "$@" ;;
    list) shift; cmd_list "$@" ;;
    launch) [[ $# -eq 2 ]] || die "usage: doppel launch <name>"; with_iab_operation_lock cmd_launch "$2" ;;
    rebuild) [[ $# -eq 2 ]] || die "usage: doppel rebuild <name>"; with_iab_operation_lock cmd_rebuild "$2" ;;
    edit) shift; with_iab_operation_lock cmd_edit "$@" ;;
    remove) shift; with_iab_operation_lock cmd_remove "$@" ;;
    update) shift; cmd_update "$@" ;;
    permissions) shift; cmd_permissions "$@" ;;
    browser) shift; cmd_browser "$@" ;;
    native-tools) shift; cmd_native_tools "$@" ;;
    remodex) shift; cmd_remodex "$@" ;;
    prune) shift; [[ $# -le 1 ]] || die "usage: doppel prune [<name>]"; cmd_prune "${1:-}" ;;
    *) die "usage: doppel {create|list|launch|rebuild|edit|remove|update|permissions|browser|native-tools|remodex|prune} ..." ;;
esac
